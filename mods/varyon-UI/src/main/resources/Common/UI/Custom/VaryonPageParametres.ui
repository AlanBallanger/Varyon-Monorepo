$C = "Common.ui";
$Sounds = "Sounds.ui";

          Group #ParametresContent {
            FlexWeight: 1;
            LayoutMode: Top;
            Visible: false;
            Padding: (Top: 10, Bottom: 10, Left: 0, Right: 0);

            Group #ParametresMenuShortcutRow {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 4);

              Label #ParametresMenuShortcutTitle {
                Text: "OUVRIR MENU :";
                Style: (FontSize: 13, TextColor: #aab8c8, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                Anchor: (Width: 150);
              }

              Group #ParametresMenuShortcutButtons {
                LayoutMode: Left;
                Anchor: (Height: 32);

                Button #ParametresMenuShortcutAlt {
                  Anchor: (Width: 84, Height: 28, Right: 8);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #1a2838)),
                    Hovered: (Background: (Color: #243448)),
                    Pressed: (Background: (Color: #1a2838)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                  Label #ParametresMenuShortcutAltLabel {
                    Text: "Alt";
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }

                Button #ParametresMenuShortcutO {
                  Anchor: (Width: 84, Height: 28, Right: 8);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #1a2838)),
                    Hovered: (Background: (Color: #243448)),
                    Pressed: (Background: (Color: #1a2838)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                  Label #ParametresMenuShortcutOLabel {
                    Text: "O";
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }

                Button #ParametresMenuShortcutDisable {
                  Anchor: (Width: 118, Height: 28);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #1a2838)),
                    Hovered: (Background: (Color: #243448)),
                    Pressed: (Background: (Color: #1a2838)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                  Label #ParametresMenuShortcutDisableLabel {
                    Text: "Aucun";
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }
              }
            }
            Group #ParametresMenuTargetRow {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 4);

              Label #ParametresMenuTargetTitle {
                Text: "Raccourci du menu :";
                Style: (FontSize: 13, TextColor: #aab8c8, RenderBold: true, VerticalAlignment: Center);
                Anchor: (Width: 200);
              }

              Group #ParametresMenuTargetButtons {
                LayoutMode: Left;
                Anchor: (Height: 32);

                Button #ParametresMenuTargetAccueil {
                  Anchor: (Width: 102, Height: 28, Right: 8);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #1a2838)),
                    Hovered: (Background: (Color: #243448)),
                    Pressed: (Background: (Color: #1a2838)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                  Label #ParametresMenuTargetAccueilLabel {
                    Text: "Accueil";
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }

                Button #ParametresMenuTargetCommandes {
                  Anchor: (Width: 118, Height: 28, Right: 8);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #1a2838)),
                    Hovered: (Background: (Color: #243448)),
                    Pressed: (Background: (Color: #1a2838)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                  Label #ParametresMenuTargetCommandesLabel {
                    Text: "Commandes";
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }

                Button #ParametresMenuTargetVaryon {
                  Anchor: (Width: 102, Height: 28);
                  Style: ButtonStyle(
                    Default: (Background: (Color: #1a2838)),
                    Hovered: (Background: (Color: #243448)),
                    Pressed: (Background: (Color: #1a2838)),
                    Sounds: $Sounds.@ButtonsLight
                  );
                  Label #ParametresMenuTargetVaryonLabel {
                    Text: "Varyon";
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    Style: (FontSize: 13, TextColor: #8899aa, HorizontalAlignment: Center, VerticalAlignment: Center);
                  }
                }
              }
            }


          }
