$C = "Common.ui";
$Sounds = "Sounds.ui";

@SettingRowBg = #000000(0.34);
@SettingInk = #F2E8D8;
@SettingMuted = #C8BEB0;
@SettingAccentGeneral = #C8A96E;
@SettingAccentNotif = #6BCB7A;
@SettingAccentDisplay = #A78BFA;
@SettingAccentMods = #E8A838;
@SettingBtn = #1a2838(0.92);
@SettingBtnHover = #243448(0.92);
@SettingBtnActive = #D4AF37(0.38);

@OptionBtnStyle = ButtonStyle(
  Default: (Background: (Color: @SettingBtn)),
  Hovered: (Background: (Color: @SettingBtnHover)),
  Pressed: (Background: (Color: @SettingBtnActive)),
  Sounds: $Sounds.@ButtonsLight
);

@SwitchBtnStyle = (
  Default: (Background: (Color: @SettingBtn)),
  Hovered: (Background: (Color: @SettingBtnHover)),
  Pressed: (Background: (Color: @SettingBtnActive)),
  Sounds: $Sounds.@ButtonsLight
);

          Group #ParametresContent {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            FlexWeight: 1;
            Visible: false;
            Padding: (Top: 4, Bottom: 4, Left: 0, Right: 0);

            Group #ParametresScrollContent {
              LayoutMode: Top;

              Group {
                Padding: (Bottom: 8);
                Label { Text: "GÉNÉRAL"; Style: (FontSize: 14, TextColor: @SettingAccentGeneral, RenderBold: true, RenderUppercase: true); }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Bottom: 16);
                Group { Anchor: (Width: 3, Top: 0, Bottom: 0); Background: (Color: @SettingAccentGeneral); }
                Group {
                  LayoutMode: Left;
                  FlexWeight: 1;
                  Background: (Color: @SettingRowBg);
                  Padding: (Full: 12);
                  Group #ParametresGeneralBlock {
                    LayoutMode: Top;
                    FlexWeight: 1;
                    Anchor: (Left: 0, Right: 0);

                    Group {
                      LayoutMode: Left;
                      Anchor: (Bottom: 12);
                      Label { FlexWeight: 1; Text: "Ouvrir menu"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresMenuShortcutAlt {
                        Anchor: (Width: 84, Height: 28, Right: 8);
                        Style: @OptionBtnStyle;
                        Label #ParametresMenuShortcutAltLabel { Text: "Alt"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresMenuShortcutO {
                        Anchor: (Width: 84, Height: 28, Right: 8);
                        Style: @OptionBtnStyle;
                        Label #ParametresMenuShortcutOLabel { Text: "O"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresMenuShortcutDisable {
                        Anchor: (Width: 118, Height: 28);
                        Style: @OptionBtnStyle;
                        Label #ParametresMenuShortcutDisableLabel { Text: "Aucun"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }

                    Group { Anchor: (Height: 1, Bottom: 12); Background: (Color: #FFFFFF(0.08)); }

                    Group {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Raccourci du menu"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresMenuTargetAccueil {
                        Anchor: (Width: 102, Height: 28, Right: 8);
                        Style: @OptionBtnStyle;
                        Label #ParametresMenuTargetAccueilLabel { Text: "Accueil"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresMenuTargetCommandes {
                        Anchor: (Width: 118, Height: 28, Right: 8);
                        Style: @OptionBtnStyle;
                        Label #ParametresMenuTargetCommandesLabel { Text: "Commandes"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresMenuTargetVaryon {
                        Anchor: (Width: 102, Height: 28);
                        Style: @OptionBtnStyle;
                        Label #ParametresMenuTargetVaryonLabel { Text: "Varyon"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }
                  }
                }
              }

              Group {
                Padding: (Bottom: 8);
                Label { Text: "NOTIFICATIONS"; Style: (FontSize: 14, TextColor: @SettingAccentNotif, RenderBold: true, RenderUppercase: true); }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Bottom: 16);
                Group { Anchor: (Width: 3, Top: 0, Bottom: 0); Background: (Color: @SettingAccentNotif); }
                Group {
                  LayoutMode: Left;
                  FlexWeight: 1;
                  Background: (Color: @SettingRowBg);
                  Padding: (Full: 12);
                  Group #ParametresNotifBlock {
                    LayoutMode: Top;
                    FlexWeight: 1;
                    Anchor: (Left: 0, Right: 0);

                    Group #ParametresActuPopupRow {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Ouverture des actualites"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresActuPopupOn {
                        Anchor: (Width: 52, Height: 28, Right: 4);
                        Style: @SwitchBtnStyle;
                        Label #ParametresActuPopupOnLabel { Text: "ON"; Anchor: (Full: 0); Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresActuPopupOff {
                        Anchor: (Width: 52, Height: 28);
                        Style: @SwitchBtnStyle;
                        Label #ParametresActuPopupOffLabel { Text: "OFF"; Anchor: (Full: 0); Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }
                  }
                }
              }

              Group {
                Padding: (Bottom: 8);
                Label { Text: "AFFICHAGE"; Style: (FontSize: 14, TextColor: @SettingAccentDisplay, RenderBold: true, RenderUppercase: true); }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Bottom: 16);
                Group { Anchor: (Width: 3, Top: 0, Bottom: 0); Background: (Color: @SettingAccentDisplay); }
                Group {
                  LayoutMode: Left;
                  FlexWeight: 1;
                  Background: (Color: @SettingRowBg);
                  Padding: (Full: 12);
                  Group #ParametresDisplayBlock {
                    LayoutMode: Top;
                    FlexWeight: 1;
                    Anchor: (Left: 0, Right: 0);

                    Group #ParametresActivityBubbleRow {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Bulles d'activite"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresActivityBubbleOn {
                        Anchor: (Width: 52, Height: 28, Right: 4);
                        Style: @SwitchBtnStyle;
                        Label #ParametresActivityBubbleOnLabel { Text: "ON"; Anchor: (Full: 0); Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresActivityBubbleOff {
                        Anchor: (Width: 52, Height: 28);
                        Style: @SwitchBtnStyle;
                        Label #ParametresActivityBubbleOffLabel { Text: "OFF"; Anchor: (Full: 0); Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }

                    Group { Anchor: (Height: 1, Bottom: 12, Top: 12); Background: (Color: #FFFFFF(0.08)); }

                    Group #ParametresPartyMenuRow {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Menu party"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresPartyMenuOpen {
                        Anchor: (Width: 102, Height: 28);
                        Style: @OptionBtnStyle;
                        Label #ParametresPartyMenuOpenLabel { Text: "Ouvrir"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }

                    Group { Anchor: (Height: 1, Bottom: 12, Top: 12); Background: (Color: #FFFFFF(0.08)); }

                    Group #ParametresQuestMenuRow {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Menu quete"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresQuestMenuOpen {
                        Anchor: (Width: 102, Height: 28);
                        Style: @OptionBtnStyle;
                        Label #ParametresQuestMenuOpenLabel { Text: "Ouvrir"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }

                    Group { Anchor: (Height: 1, Bottom: 12, Top: 12); Background: (Color: #FFFFFF(0.08)); }

                    Group #ParametresDmgNumRow {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Degats personnalises"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresDmgNumOn {
                        Anchor: (Width: 52, Height: 28, Right: 4);
                        Style: @SwitchBtnStyle;
                        Label #ParametresDmgNumOnLabel { Text: "ON"; Anchor: (Full: 0); Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                      Button #ParametresDmgNumOff {
                        Anchor: (Width: 52, Height: 28);
                        Style: @SwitchBtnStyle;
                        Label #ParametresDmgNumOffLabel { Text: "OFF"; Anchor: (Full: 0); Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }
                  }
                }
              }

              Group {
                Padding: (Bottom: 8);
                Label { Text: "MODS"; Style: (FontSize: 14, TextColor: @SettingAccentMods, RenderBold: true, RenderUppercase: true); }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Bottom: 8);
                Group { Anchor: (Width: 3, Top: 0, Bottom: 0); Background: (Color: @SettingAccentMods); }
                Group {
                  LayoutMode: Left;
                  FlexWeight: 1;
                  Background: (Color: @SettingRowBg);
                  Padding: (Full: 12);
                  Group #ParametresModsBlock {
                    LayoutMode: Top;
                    FlexWeight: 1;
                    Anchor: (Left: 0, Right: 0);

                    Group #ParametresRpgSettingsRow {
                      LayoutMode: Left;
                      Label { FlexWeight: 1; Text: "Parametres classes et metiers"; Style: (FontSize: 15, TextColor: @SettingInk, RenderBold: true, VerticalAlignment: Center); }
                      Button #ParametresRpgSettingsOpen {
                        Anchor: (Width: 102, Height: 28);
                        Style: @OptionBtnStyle;
                        Label #ParametresRpgSettingsOpenLabel { Text: "Ouvrir"; Anchor: (Full: 0); Style: (FontSize: 13, TextColor: @SettingMuted, HorizontalAlignment: Center, VerticalAlignment: Center); }
                      }
                    }
                  }
                }
              }
            }
          }
