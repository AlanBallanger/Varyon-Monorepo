$C = "Common.ui";
$Sounds = "Sounds.ui";

          Group #CommandesContent {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Visible: false;
            Padding: (Top: 0, Bottom: 0, Left: 0, Right: 0);
          
            Group #CommandesList {
              LayoutMode: Top;
            
              Group #CategoryHeader1 {
                LayoutMode: Left;
                Anchor: (Top: 4, Bottom: 8, Left: 0, Right: 0);
                Visible: false;
                Padding: (Left: 10, Right: 12, Top: 8, Bottom: 8);
                Background: "Icons/BgCategory.png";

                Group #CategoryHeader1Icon {
                  Anchor: (Width: 30, Height: 30, Right: 10);
                  Background: (Color: #00000000);
                }

                Label #CategoryTitle1 {
                  Text: "Se dÃƒÂ©placer";
                  Style: (FontSize: 18, RenderBold: true, TextColor: #dceeff, VerticalAlignment: Center);
                  FlexWeight: 1;
                }
              }
            
              Group #ButtonRow1 {
                LayoutMode: Left;
                Anchor: (Height: 110, Bottom: 8);
                Visible: false;
              
                Button #CommandButton1 {
                  Anchor: (Width: 152, Height: 110, Right: 10);
                  Visible: false;
                  Style: ButtonStyle(
                    Default: (Background: "Icons/Yelow_Button_small.png"),
                    Hovered: (Background: "Icons/Yelow_Button_small_Hovered.png"),
                    Pressed: (Background: "Icons/Yelow_Button_small_Hovered.png"),
                    Sounds: $Sounds.@ButtonsLight
                  );
                
                  Group {
                    LayoutMode: Top;
                    Padding: (Top: 8, Bottom: 2, Left: 8, Right: 8);
                  
                    Group {
                      LayoutMode: Middle;
                      Anchor: (Height: 68, Left: 0, Right: 0);
                      Group #CommandButton1Icon {
                        Anchor: (Width: 68, Height: 68);
                        Background: "Icons/Spawn_Icon.png";
                      }
                    }
                  
                    Label #CommandButton1Label {
                      Text: "Button 1";
                      Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, Wrap: true);
                    }
                  
                    Label #CommandButton1Cmd {
                      Anchor: (Top: -5);
                      Text: "/command";
                      Style: (FontSize: 12, TextColor: #e8e8e8, HorizontalAlignment: Center);
                    }
                  }
                }
              
