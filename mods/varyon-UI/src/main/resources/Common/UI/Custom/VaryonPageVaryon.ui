                      Text: "";
                      Style: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Start, Wrap: true);
                    }
                    Label #VaryonQuickButton2Cmd {
                      Text: "";
                      Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Start, Wrap: true);
                    }
                  }
                }
              }

              Button #VaryonQuickButton3 {
                Anchor: (Width: 152, Height: 53, Right: 12);
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
