                    }
                    Label #VaryonQuickButton4Cmd {
                      Text: "";
                      Style: (FontSize: 10, TextColor: #aaaaaa, HorizontalAlignment: Start, Wrap: true);
                    }
                  }
                }
              }

              Button #VaryonQuickButton5 {
                Anchor: (Width: 152, Height: 53);
                Style: ButtonStyle(
                  Default: (Background: (Color: #2a4a6a)),
                  Hovered: (Background: (Color: #3a5a7a)),
