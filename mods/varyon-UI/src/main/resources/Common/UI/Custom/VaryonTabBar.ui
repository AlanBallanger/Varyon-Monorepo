$C = "Common.ui";
$Sounds = "Sounds.ui";

@VaryonTabBarSounds = (
  Activate: (
    SoundPath: "Sounds/TopBarActivate.ogg",
    Volume: 11
  ),
  MouseHover: (
    SoundPath: "Sounds/ButtonsMainHover.ogg",
    MinPitch: -0.15,
    MaxPitch: 0.15,
    Volume: 14
  )
);

        Group #TabBar {
          LayoutMode: Left;
          Anchor: (Height: 70);

          Padding: (Top: 14, Left: 8, Right: 8, Bottom: 0);

          Group #HomeTabContainer {
            Anchor: (Top: 0, Bottom: 0, Width: 70);
            Padding: (Right: 2);

            Button #HomeTab {
              TooltipText: "Accueil";
              TextTooltipShowDelay: 0.001;
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 2);
              Style: ButtonStyle(
                Default: (Background: (Color: #00000000)),
                Hovered: (Background: (Color: #ffffff18)),
                Pressed: (Background: (Color: #00000030)),
                Sounds: @VaryonTabBarSounds
              );

              Group {
                LayoutMode: Middle;
                Group #HomeIcon {
                  Anchor: (Width: 44, Height: 44);
                  Background: "Icons/Accueil.png";
                }
              }
            }

            Group #HomeTabUnderline {
              Anchor: (Height: 2, Left: 0, Right: 0, Bottom: 0);
              Background: (Color: #F3F5F6);
              Visible: false;
            }
          }


          Group #TutorielTabContainer {
            Anchor: (Top: 0, Bottom: 0, Width: 70);
            Padding: (Right: 2);

            Button #TutorielTab {
              TooltipText: "Tutoriel";
              TextTooltipShowDelay: 0.001;
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 2);
              Style: ButtonStyle(
                Default: (Background: (Color: #00000000)),
                Hovered: (Background: (Color: #ffffff18)),
                Pressed: (Background: (Color: #00000030)),
                Sounds: @VaryonTabBarSounds
              );

              Group {
                LayoutMode: Middle;
                Group #TutorielIcon {
                  Anchor: (Width: 44, Height: 44);
                  Background: "Icons/Tutoriel.png";
                }
              }
            }

            Group #TutorielTabUnderline {
              Anchor: (Height: 2, Left: 0, Right: 0, Bottom: 0);
              Background: (Color: #F3F5F6);
              Visible: false;
            }
          }
          Group #CommandesTabContainer {
            Anchor: (Top: 0, Bottom: 0, Width: 70);
            Padding: (Right: 2);

            Button #CommandesTab {
              TooltipText: "Commandes";
              TextTooltipShowDelay: 0.001;
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 2);
              Style: ButtonStyle(
                Default: (Background: (Color: #00000000)),
                Hovered: (Background: (Color: #ffffff18)),
                Pressed: (Background: (Color: #00000030)),
                Sounds: @VaryonTabBarSounds
              );

              Group {
                LayoutMode: Middle;
