                Default: (Background: (Color: #00000000)),
                Hovered: (Background: (Color: #ffffff18)),
                Pressed: (Background: (Color: #00000030)),
                Sounds: @VaryonTabBarSounds
              );

              Group {
                LayoutMode: Middle;
                Group #PlaytimeIcon {
                  Anchor: (Width: 44, Height: 44);
                  Background: "Icons/Temps.png";
                }
              }
            }

            Group #PlaytimeTabUnderline {
              Anchor: (Height: 2, Left: 0, Right: 0, Bottom: 0);
              Background: (Color: #F3F5F6);
              Visible: false;
            }
          }
          Group #JournalTabContainer {
            Anchor: (Top: 0, Bottom: 0, Width: 70);
            Padding: (Right: 2);

            Button #JournalTab {
              TooltipText: "Journal de quêtes";
              TextTooltipShowDelay: 0.001;
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 2);
              Style: ButtonStyle(
                Default: (Background: (Color: #00000000)),
                Hovered: (Background: (Color: #ffffff18)),
                Pressed: (Background: (Color: #00000030)),
                Sounds: @VaryonTabBarSounds
              );

              Group {
                LayoutMode: Middle;
                Group #JournalIcon {
                  Anchor: (Width: 44, Height: 44);
                  Background: "Icons/Quetes.png";
                }
              }
            }
          }
          Group #ParametresTabContainer {
            Anchor: (Top: 0, Bottom: 0, Width: 70);
            Padding: (Right: 2);

            Button #ParametresTab {
              TooltipText: "Paramètres";
              TextTooltipShowDelay: 0.001;
              Anchor: (Top: 0, Left: 0, Right: 0, Bottom: 2);
