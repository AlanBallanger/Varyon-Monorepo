          Group #PlaytimeTabContainer {
            Anchor: (Top: 0, Bottom: 0, Width: 70);
            Padding: (Right: 2);

            Button #PlaytimeTab {
              TooltipText: "Temps de jeu";
              TextTooltipShowDelay: 0.001;
