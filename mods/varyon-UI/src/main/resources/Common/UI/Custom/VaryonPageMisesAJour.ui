$C = "Common.ui";
$Sounds = "Sounds.ui";

          Group #MisesAJourContent {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Visible: false;
            Padding: (Top: 0, Bottom: 0, Left: 0, Right: 0);
          
            Group #NewsEntry1 {
              LayoutMode: Top;
              Anchor: (Bottom: 12);
              Visible: false;
            
              Label #NewsDate1 {
                Text: "Date";
                Style: (FontSize: 11, TextColor: #6699bb);
                Anchor: (Bottom: 2);
              }
            
              Label #NewsTitle1 {
                Text: "Title";
                Style: (FontSize: 16, RenderBold: true, TextColor: #aaddff);
                Anchor: (Bottom: 4);
              }
            
              Label #NewsContent1 { Text: "Content"; Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); Anchor: (Bottom: 6, Width: 600); }
            
              Group #NewsSeparator1 {
                Anchor: (Height: 1);
                Background: (Color: #2a3a4a);
              }
            }
