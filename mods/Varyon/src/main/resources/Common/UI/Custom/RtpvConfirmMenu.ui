$C = "Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 360, Height: 218);

    #Title {
      Group {
        LayoutMode: Left;

        Label #TitleLabel {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center, Wrap: true);
        }

        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 24, Height: 24, Top: 2, Right: 8);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
          );
        }
      }
    }

    #Content {
      Padding: (Top: 4, Bottom: 4, Left: 12, Right: 12);
      LayoutMode: Top;

      Label #Subtitle {
        Anchor: (Bottom: 12, Left: 0, Right: 0);
        Text: "Garder cet emplacement ?";
        Style: (FontSize: 14, TextColor: #c8d6e0, HorizontalAlignment: Center, Wrap: true);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 10, Height: 44);

        Button #YesButton {
          FlexWeight: 1;
          Anchor: (Right: 10, Height: 44);
          Style: ButtonStyle(
            Default: (Background: (Color: #185a28)),
            Hovered: (Background: (Color: #286a38)),
            Pressed: (Background: (Color: #0f4018))
          );
          OutlineColor: #083818;
          OutlineSize: 1;
          Group {
            LayoutMode: Middle;
            Label #YesButtonLabel {
              Text: "Oui, je reste ici";
              Style: (FontSize: 12, RenderBold: true, TextColor: #aaffaa, HorizontalAlignment: Center, Wrap: true);
            }
          }
        }

        Button #MaybeButton {
          FlexWeight: 1;
          Anchor: (Height: 44);
          Style: ButtonStyle(
            Default: (Background: (Color: #2f4555)),
            Hovered: (Background: (Color: #3f5568)),
            Pressed: (Background: (Color: #1f3545))
          );
          OutlineColor: #152530;
          OutlineSize: 1;
          Group {
            LayoutMode: Middle;
            Label #MaybeButtonLabel {
              Text: ".";
              Style: (FontSize: 11, RenderBold: true, TextColor: #c8dce8, HorizontalAlignment: Center, Wrap: true);
            }
          }
        }
      }

      Group {
        LayoutMode: Top;
        Anchor: (Top: 14, Height: 44);

        Button #NoButton {
          Anchor: (Left: 0, Right: 0, Height: 44);
          Style: ButtonStyle(
            Default: (Background: (Color: #c86a12)),
            Hovered: (Background: (Color: #e88820)),
            Pressed: (Background: (Color: #904808))
          );
          OutlineColor: #5a3006;
          OutlineSize: 1;
          Group {
            LayoutMode: Middle;
            Label #NoButtonLabel {
              Text: "Non";
              Style: (FontSize: 13, RenderBold: true, TextColor: #ffe8c8, HorizontalAlignment: Center, Wrap: true);
            }
          }
        }
      }
    }
  }
}