$C = "Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 520, Height: 600);

    #Title {
      Group {
        LayoutMode: Left;

        Label #MenuTitle {
          FlexWeight: 1;
          Text: "Classement des tiers Varyon";
          Style: (FontSize: 24, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }

        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 36, Height: 36, Top: 2, Right: 12);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Sounds: $C.@ButtonSounds
          );
        }
      }
    }

    #Content {
      Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
      LayoutMode: Top;

      Group #ColumnHeader {
        Anchor: (Left: 0, Right: 0, Height: 28);
        LayoutMode: Left;
        Background: (Color: #1A2030);
        Padding: (Left: 8, Right: 4);

        Label {
          Anchor: (Width: 44, Height: 28);
          Style: (FontSize: 11, TextColor: #A09080, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "Rang";
        }

        Label {
          FlexWeight: 1;
          Anchor: (Height: 28);
          Style: (FontSize: 11, TextColor: #A09080, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
          Text: "Joueur";
        }

        Label {
          Anchor: (Width: 96, Height: 28);
          Style: (FontSize: 11, TextColor: #A09080, RenderBold: true, RenderUppercase: true, HorizontalAlignment: End, VerticalAlignment: Center);
          Text: "Tier";
        }

        Group { Anchor: (Width: 8); }
      }

      Group { Anchor: (Height: 2); }

      Group #TierListScroll {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #TierListContainer {
          LayoutMode: Top;
        }
      }
    }
  }
}
