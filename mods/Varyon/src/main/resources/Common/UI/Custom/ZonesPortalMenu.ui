$C = "Common.ui";

$C.@PageOverlay {

  Group #ZonesPortalRoot {
    Anchor: (Width: 852, Height: 595);
    LayoutMode: Top;

    Group #Title {
      Anchor: (Height: 38, Top: 0);
      LayoutMode: Left;
      Padding: (Left: 10, Right: 6, Top: 4, Bottom: 4);
      Background: PatchStyle(TexturePath: "Icons/ContainerHeader.png", HorizontalBorder: 214, VerticalBorder: 0);

      Group {
        FlexWeight: 1;
        LayoutMode: Middle;
        Label #MenuTitle {
          FlexWeight: 1;
          Text: "Teleportation zones Varyon";
          Style: (FontSize: 18, RenderBold: true, TextColor: #f2ecff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
      }

      Button #CloseButton {
        Anchor: (Width: 32, Height: 32);
        Style: (
          Default: (Background: "Icons/ContainerCloseButton.png"),
          Hovered: (Background: "Icons/ContainerCloseButtonHovered.png"),
          Pressed: (Background: "Icons/ContainerCloseButtonPressed.png"),
        );
      }
    }

    Group #Content {
      FlexWeight: 1;
      LayoutMode: Top;
      Background: PatchStyle(TexturePath: "Icons/ContainerPatch.png", Border: 46);
      Padding: (Top: 10, Bottom: 10, Left: 0, Right: 0);

      Group #Row1 {
        LayoutMode: Left;
        Anchor: (Height: 209, Bottom: 8);
        Padding: (Left: 22, Right: 22);

        Group #ZoneCard1 {
          FlexWeight: 1;
          Anchor: (Right: 4);
          Background: (Color: #201a36);
          OutlineColor: #3d3458;
          OutlineSize: 3;
          LayoutMode: Top;
          Padding: (Left: 4, Right: 4, Top: 4, Bottom: 4);

          Group {
            Anchor: (Height: 21);
            Padding: (Left: 7, Right: 7);
            LayoutMode: Middle;
            Label {
              Text: "Zone 1";
              Style: (FontSize: 12, RenderBold: true, TextColor: #efe8ff, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }

          Group #ZoneImg1 {
            Anchor: (Height: 72);
            Background: "varyon_zones.png";
          }

          Group #ZoneRadius1 {
            Anchor: (Height: 31);
            Padding: (Left: 4, Right: 4, Top: 3, Bottom: 2);
            LayoutMode: Top;
            Label #ZoneRadiusTitle1 {
              Text: "RAYON";
              Style: (FontSize: 10, RenderBold: true, TextColor: #c4b8e8, HorizontalAlignment: Center);
            }
            Label #ZoneRadiusValue1 {
              Text: "";
              Style: (FontSize: 9, TextColor: #f0ecf8, HorizontalAlignment: Center, Wrap: false);
            }
          }

          Group {
            Padding: (Left: 2, Right: 2, Top: 1, Bottom: 3);
            LayoutMode: Top;

            Button #ZoneMain1 {
              Anchor: (Height: 36, Bottom: 3);
              Style: ButtonStyle(
                Default: (Background: (Color: #2A2448)),
                Hovered: (Background: (Color: #2e2a48)),
                Pressed: (Background: (Color: #18162a))
              );
              OutlineColor: #141228;
              OutlineSize: 1;
              Group {
                Anchor: (Full: 0);
                LayoutMode: CenterMiddle;
                Label #ZoneMainLead1 {
                  Text: "";
                  Style: (FontSize: 12, RenderBold: true, TextColor: #c8c2e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
                Group #ZoneMainCoinSlot1 {
                  Anchor: (Width: 22, Height: 22);
                  Padding: (Left: 3, Right: 3);
                  LayoutMode: Middle;
                  ItemIcon #ZoneMainCoin1 { Anchor: (Width: 22, Height: 22); }
                }
                Label #ZoneMainAmount1 {
                  Text: "";
                  Style: (FontSize: 12, RenderBold: true, TextColor: #c8c2e0, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 35);

              Button #ZonePvP1 {
                FlexWeight: 1;
                Anchor: (Right: 3);
                Style: ButtonStyle(
                  Default: (Background: (Color: #521420)),
                  Hovered: (Background: (Color: #621a28)),
                  Pressed: (Background: (Color: #3a0c14))
                );
                OutlineColor: #300810;
                OutlineSize: 1;
                Group {
                  LayoutMode: Middle;
                  Padding: (Top: 1, Bottom: 1, Left: 1, Right: 1);
                  Group {
                    LayoutMode: Top;
                    Group {
                      LayoutMode: Middle;
                      Label {
                        Text: "PvP actif";
                        Style: (FontSize: 10, RenderBold: true, TextColor: #e09090, HorizontalAlignment: Center, VerticalAlignment: Center);
                      }
                    }
                    Group #ZonePvPPriceRow1 {
                      LayoutMode: CenterMiddle;
                      Anchor: (Top: 1, Height: 16);
                      Group #ZonePvPCoinSlot1 {
                        Anchor: (Width: 14, Height: 14);
                        Padding: (Right: 3);
                        LayoutMode: Middle;
                        ItemIcon #ZonePvPCoin1 { Anchor: (Width: 14, Height: 14); }
                      }
                      Label #ZonePvPPrice1 {
                        Text: "";
                        Style: (FontSize: 10, TextColor: #e8d0d0, HorizontalAlignment: Center, VerticalAlignment: Center);
                      }
                    }
                  }
                }
              }

              Button #ZoneSafe1 {
                FlexWeight: 1;
                Style: ButtonStyle(
                  Default: (Background: (Color: #1e5c2e)),
                  Hovered: (Background: (Color: #2a7038)),
                  Pressed: (Background: (Color: #144522))
                );
                OutlineColor: #0c3818;
                OutlineSize: 1;
