                  LayoutMode: Middle;
                  Padding: (Top: 1, Bottom: 1, Left: 1, Right: 1);
                  Group {
                    LayoutMode: Top;
                    Group {
                      LayoutMode: Middle;
                      Label {
                        Text: "PvP inactif";
                        Style: (FontSize: 10, RenderBold: true, TextColor: #a8e8a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                      }
                    }
