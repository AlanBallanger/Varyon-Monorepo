                      Group #ZoneSafeCoinSlot1 {
                        Anchor: (Width: 14, Height: 14);
                        Padding: (Right: 3);
                        LayoutMode: Middle;
                        ItemIcon #ZoneSafeCoin1 { Anchor: (Width: 14, Height: 14); }
                      }
                      Label #ZoneSafePrice1 {
                        Text: "";
                        Style: (FontSize: 10, TextColor: #d0ead8, HorizontalAlignment: Center, VerticalAlignment: Center);
                      }
                    }
                  }
                }
              }
            }
          }
        }

