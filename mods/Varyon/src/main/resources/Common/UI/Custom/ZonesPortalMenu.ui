                      Label {
                        Text: "PvP inactif";
                        Style: (FontSize: 10, RenderBold: true, TextColor: #a8e8a8, HorizontalAlignment: Center, VerticalAlignment: Center);
                      }
                    }
                    Group #ZoneSafePriceRow10 {
                      LayoutMode: CenterMiddle;
                      Anchor: (Top: 1, Height: 16);
                      Group #ZoneSafeCoinSlot10 {
                        Anchor: (Width: 14, Height: 14);
                        Padding: (Right: 3);
                        LayoutMode: Middle;
                        ItemIcon #ZoneSafeCoin10 { Anchor: (Width: 14, Height: 14); }
                      }
                      Label #ZoneSafePrice10 {
                        Text: "";
                        Style: (FontSize: 10, TextColor: #d0ead8, HorizontalAlignment: Center, VerticalAlignment: Center);
                      }
                    }
                  }
                }
              }
            }
          }
        }

      }

      Group #HowItWorksBanner {
        Padding: (Left: 22, Right: 22);
        LayoutMode: Top;
        Anchor: (Top: 8);
        Group {
          LayoutMode: Top;
          Anchor: (Height: 92);
          Background: (Color: #201a36);
          OutlineColor: #3d3458;
          OutlineSize: 3;
          Padding: (Left: 12, Right: 8, Top: 12, Bottom: 6);
          Group {
            LayoutMode: Left;
            Anchor: (Height: 22, Bottom: 5);
            Group {
              Anchor: (Width: 18, Height: 18, Right: 6);
              Background: "Icons/Info.png";
            }
            Label #HowItWorksTitle {
              FlexWeight: 1;
              Text: "COMMENT ÇA MARCHE ?";
              Style: (FontSize: 14, RenderBold: true, TextColor: #7ec8e8, VerticalAlignment: Center, HorizontalAlignment: Start);
            }
          }
          Label #HowItWorksBody {
            Text: "Choisis une zone pour t'y téléporter aléatoirement dans le rayon indiqué. Les coûts augmentent avec la difficulté de chaque zone.";
            Style: (FontSize: 12, TextColor: #9eb8d0, HorizontalAlignment: Start, Wrap: true);
          }
        }
      }

    }
  }
}
