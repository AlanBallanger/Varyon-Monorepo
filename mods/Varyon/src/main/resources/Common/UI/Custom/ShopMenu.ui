              Style: ButtonStyle(Default: (Background: (Color: #1a5a9a)), Hovered: (Background: (Color: #2a6aaa)), Pressed: (Background: (Color: #104878)), Disabled: (Background: (Color: #4a4a4a)), Sounds: $C.@ButtonSounds);
              Group { LayoutMode: Middle; Label { Text: "Acheter"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); } }
            }
            Button #MaxButton9 {
              FlexWeight: 1;
              Style: ButtonStyle(Default: (Background: (Color: #2a7a3a)), Hovered: (Background: (Color: #3a8a4a)), Pressed: (Background: (Color: #1a5a28)), Disabled: (Background: (Color: #4a4a4a)), Sounds: $C.@ButtonSounds);
              Group { LayoutMode: Middle; Label { Text: "Max"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); } }
            }
          }
        }
      }

      Group #Row4 {
        LayoutMode: Left;
        Anchor: (Height: 150);
        Group #Item10 {
          FlexWeight: 1;
          
          Background: (Color: #0b1624);
          OutlineColor: #2a3a4a;
          OutlineSize: 2;
          LayoutMode: Top;
          Padding: (Top: 8, Left: 8, Right: 8, Bottom: 8);
          Label #Item10Label { Text: "Clé Zone 10"; Style: (FontSize: 14, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); Anchor: (Height: 24, Bottom: 4, Left: 0, Right: 0); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 20, Bottom: 2);
            Label { Text: "Coût"; Style: (FontSize: 16, RenderBold: true, TextColor: #ff4444); Anchor: (Width: 90, Left: 24); }
            Group { FlexWeight: 1; }
            Label { Text: "Obtient"; Style: (FontSize: 16, RenderBold: true, TextColor: #44ff44); Anchor: (Width: 90, Right: 16); }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 48, Left: 0, Right: 0);
            Label #Item10Cost { Text: "100x"; Style: (FontSize: 14, TextColor: #aacc88, VerticalAlignment: Center); Anchor: (Width: 44, Left: 24, Right: 2); }
            ItemIcon #Item10FragmentIcon { Anchor: (Width: 40, Height: 40, Right: 40); }
            
            Label #Item10Arrow { Text: "->"; Style: (FontSize: 16, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center); Anchor: (Width: 24, Right: 40); }
            Label #Item10Reward { Text: "1x"; Style: (FontSize: 14, TextColor: #88dd88, VerticalAlignment: Center); Anchor: (Width: 32, Right: 2); }
            ItemIcon #Item10KeyIcon { Anchor: (Width: 40, Height: 40, Right: 16); }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 36, Bottom: 4, Left: 0, Right: 0);
            Button #BuyButton10 {
              FlexWeight: 2;
              Anchor: (Right: 4);
              Style: ButtonStyle(Default: (Background: (Color: #1a5a9a)), Hovered: (Background: (Color: #2a6aaa)), Pressed: (Background: (Color: #104878)), Disabled: (Background: (Color: #4a4a4a)), Sounds: $C.@ButtonSounds);
              Group { LayoutMode: Middle; Label { Text: "Acheter"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); } }
            }
            Button #MaxButton10 {
              FlexWeight: 1;
              Style: ButtonStyle(Default: (Background: (Color: #2a7a3a)), Hovered: (Background: (Color: #3a8a4a)), Pressed: (Background: (Color: #1a5a28)), Disabled: (Background: (Color: #4a4a4a)), Sounds: $C.@ButtonSounds);
              Group { LayoutMode: Middle; Label { Text: "Max"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); } }
            }
          }
        }
        Group { FlexWeight: 1; }
        Group { FlexWeight: 1; }
      }
    }
  }
}