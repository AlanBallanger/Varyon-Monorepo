$C = "Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 1100, Height: 720);

    #Title {
      Group {
        LayoutMode: Left;

        Label #MenuTitle {
          FlexWeight: 1;
          Text: "Boutique de clé varyon";
          Style: (FontSize: 24, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }

        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 36, Height: 36, Top: 2, Right: 12);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Sounds: $C.@ButtonSounds
          );
        }
      }
    }

    #Content {
      Padding: (Top: 16, Bottom: 16, Left: 16, Right: 16);
      LayoutMode: Top;

      Group #Row1 {
        LayoutMode: Left;
        Anchor: (Height: 150, Bottom: 10);
        Group #Item1 {
          FlexWeight: 1;
          Anchor: (Right: 10);
          Background: (Color: #0b1624);
          OutlineColor: #2a3a4a;
          OutlineSize: 2;
          LayoutMode: Top;
          Padding: (Top: 8, Left: 8, Right: 8, Bottom: 8);
          Label #Item1Label { Text: "Clé Zone 1"; Style: (FontSize: 14, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); Anchor: (Height: 24, Bottom: 4, Left: 0, Right: 0); }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 20, Bottom: 2);
            Label { Text: "Coût"; Style: (FontSize: 16, RenderBold: true, TextColor: #ff4444); Anchor: (Width: 90, Left: 24); }
            Group { FlexWeight: 1; }
            Label { Text: "Obtient"; Style: (FontSize: 16, RenderBold: true, TextColor: #44ff44); Anchor: (Width: 90, Right: 16); }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 48, Left: 0, Right: 0);
            Label #Item1Cost { Text: "100x"; Style: (FontSize: 14, TextColor: #aacc88, VerticalAlignment: Center); Anchor: (Width: 44, Left: 24, Right: 2); }
            ItemIcon #Item1FragmentIcon { Anchor: (Width: 40, Height: 40, Right: 40); }
            Label #Item1Arrow { Text: "->"; Style: (FontSize: 16, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center); Anchor: (Width: 24, Right: 40); }
            Label #Item1Reward { Text: "1x"; Style: (FontSize: 14, TextColor: #88dd88, VerticalAlignment: Center); Anchor: (Width: 32, Right: 2); }
            ItemIcon #Item1KeyIcon { Anchor: (Width: 40, Height: 40, Right: 16); }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 36, Bottom: 4, Left: 0, Right: 0);
            Button #BuyButton1 {
              FlexWeight: 2;
              Anchor: (Right: 4);
              Style: ButtonStyle(Default: (Background: (Color: #1a5a9a)), Hovered: (Background: (Color: #2a6aaa)), Pressed: (Background: (Color: #104878)), Disabled: (Background: (Color: #4a4a4a)), Sounds: $C.@ButtonSounds);
              Group { LayoutMode: Middle; Label { Text: "Acheter"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); } }
            }
            Button #MaxButton1 {
              FlexWeight: 1;
              Style: ButtonStyle(Default: (Background: (Color: #2a7a3a)), Hovered: (Background: (Color: #3a8a4a)), Pressed: (Background: (Color: #1a5a28)), Disabled: (Background: (Color: #4a4a4a)), Sounds: $C.@ButtonSounds);
              Group { LayoutMode: Middle; Label { Text: "Max"; Style: (FontSize: 12, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center); } }
            }
          }
        }
        Group #Item2 {
          FlexWeight: 1;
