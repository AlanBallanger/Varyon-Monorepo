$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 640, Height: 720);

    #Title {
      Group {
        LayoutMode: Left;

        Label {
          FlexWeight: 1;
          Text: "ZONES MUSICALES";
          Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }

        TextButton #ListCloseButton {
          Text: "X";
          Anchor: (Width: 24, Height: 24, Top: 2, Right: 8);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Sounds: $C.@ButtonSounds
          );
        }
      }
    }

    #Content {
      Padding: (Top: 4, Bottom: 10, Left: 10, Right: 10);
      LayoutMode: Top;

      Label #WorldLabel {
        Anchor: (Height: 20, Bottom: 4);
        Text: "Monde : ?";
        Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center, HorizontalAlignment: Start);
      }

      Label #EmptyLabel {
        Anchor: (Height: 24, Bottom: 4);
        Text: "Aucune zone dans ce dossier.";
        Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
      }

      Group #ListScroll {
        Anchor: (Height: 380);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: #0a0f17);
        Padding: (Full: 4);

        Group #ZoneList {
          LayoutMode: Top;
        }
      }

      Group { Anchor: (Height: 8); }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 6);

        Label {
          Text: "Nouveau dossier";
          Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
          Anchor: (Width: 110);
        }

        $C.@TextField #CreateGroupInput {
          @Anchor = (Width: 170, Height: 32);
        }

        $C.@SecondaryTextButton #CreateGroupButton {
          @Text = "CREER";
          @Anchor = (Width: 120, Height: 32, Left: 6);
        }
      }

      Group {
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        Label {
          Text: "Dossier (optionnel)";
          Style: (FontSize: 12, TextColor: #96a9be);
          Anchor: (Bottom: 3);
        }

        $C.@TextField #CreateZoneGroupInput {
          @Anchor = (Height: 30, Bottom: 6);
        }

        Label {
          Text: "Nom de la zone (obligatoire)";
          Style: (FontSize: 12, TextColor: #96a9be);
          Anchor: (Bottom: 3);
        }

        $C.@TextField #CreateNameInput {
          @Anchor = (Height: 30);
        }
      }

      Button #CreateButton {
        Anchor: (Left: 0, Right: 0, Height: 40, Top: 6);
        Style: ButtonStyle(
          Default: (Background: (Color: #185a28)),
          Hovered: (Background: (Color: #286a38)),
          Pressed: (Background: (Color: #0f4018)),
          Sounds: $C.@ButtonSounds
        );
        OutlineColor: #083818;
        OutlineSize: 1;
        Group {
          LayoutMode: Middle;
          Label {
            Text: "CREER UNE ZONE (autour de moi)";
            Style: (FontSize: 13, RenderBold: true, TextColor: #aaffaa, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }
    }
  }
}
