$C = "../Common.ui";

$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 250);

    #Title {
      Group {
        $C.@Title {
          @Text = "SUBOWNER TEST";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #InfoLabel {
        Text: "Click buttons to test events";
        Anchor: (Bottom: 20);
      }

      Label { FlexWeight: 1; }

      Group #ButtonSection {
        LayoutMode: Right;
        Anchor: (Height: 44);

        $C.@TextButton #SaveButton {
          Text: "SAVE TEST";
          Padding: (Left: 16, Right: 16);
          Anchor: (Right: 8);
        }

        $C.@CancelTextButton #CancelButton {
          Text: "CANCEL TEST";
          Padding: (Left: 16, Right: 16);
        }
      }
    }
  }
}

$C.@BackButton {}
