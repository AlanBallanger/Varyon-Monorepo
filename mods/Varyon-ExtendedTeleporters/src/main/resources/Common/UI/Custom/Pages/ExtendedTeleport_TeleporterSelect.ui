$C = "../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 220);

    #Title {
      Group {
        $C.@Title {
          @Text = %extendedteleporters.select.title;
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 14);

      // Selection Section
      Group #SelectionSection {
        LayoutMode: Top;
        Anchor: (Bottom: 12);

        Label #SelectLabel {
          Text: %extendedteleporters.select.chooseTeleporter;
          Style: (RenderUppercase: true, RenderBold: true, FontSize: 13, TextColor: #96a9be);
          Anchor: (Bottom: 6);
        }

        $C.@DropdownBox #TeleporterDropdown {
          Anchor: (Height: 34);
          Style: (...@DefaultDropdownBoxStyle, PanelAlign: Bottom, PanelOffset: 5);
        }

        Label #EmptyLabel {
          Text: %extendedteleporters.select.noTeleporters;
          Style: (FontSize: 12, TextColor: #666666);
          Visible: false;
        }
      }

      Label { FlexWeight: 1; }

      // Buttons
      Group #ButtonSection {
        LayoutMode: Right;
        Anchor: (Height: 44);

        $C.@TextButton #ManageButton {
          Text: %extendedteleporters.select.manage;
          Padding: (Left: 16, Right: 16);
          Anchor: (Right: 8);
        }

        $C.@CancelTextButton #CancelButton {
          Text: %extendedteleporters.select.cancel;
          Padding: (Left: 16, Right: 16);
        }
      }
    }
  }
}

$C.@BackButton {}
