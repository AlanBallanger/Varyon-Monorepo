$C = "../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 620, Height: 520);

    #Title {
      Group {
        $C.@Title {
          @Text = %extendedteleporters.gui.title;
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 14);

      // === TELEPORTER SELECTION (only for list view) ===
      Group #TeleporterSelectionSection {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label #SelectLabel {
          Text: %extendedteleporters.gui.selectTeleporter;
          Style: (RenderUppercase: true, RenderBold: true, FontSize: 15);
          Anchor: (Bottom: 4);
        }

        $C.@DropdownBox #TeleporterDropdown {
          Anchor: (Height: 34);
          Style: (
            ...@DefaultDropdownBoxStyle,
            PanelAlign: Bottom,
            PanelOffset: 5,
            SearchInputStyle: DropdownBoxSearchInputStyle(
              Anchor: (Height: 18),
              Padding: (Left: 26, Right: 22),
              PlaceholderText: %server.customUI.searchPlaceholder,
              PlaceholderStyle: (TextColor: #3d5a85, RenderUppercase: true, FontSize: 13),
              Icon: (Texture: "Common/SearchIcon.png", Width: 14, Height: 14, Offset: 8),
              ClearButtonStyle: $C.@ClearButtonStyle
            )
          );
          ShowSearchInput: true;
        }
      }

      // === WARP CONFIGURATION ===
      Group #WarpConfigSection {
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        // Warp Name
        Label #WarpNameLabel {
          Text: %extendedteleporters.gui.warpName;
          Style: (RenderUppercase: true, RenderBold: true, FontSize: 15);
          Anchor: (Bottom: 4);
        }

        $C.@TextField #WarpNameField {
          Anchor: (Bottom: 10, Height: 34);
          MaxLength: 64;
          Style: (FontSize: 12, TextColor: #ffffff(0.85));
        }

        // Warp Destination Header with filter
        Group #DestinationHeader {
          LayoutMode: Right;
          Anchor: (Bottom: 4);

          Label #WarpDestinationLabel {
            Text: %extendedteleporters.gui.warpDestination;
            Style: (RenderUppercase: true, RenderBold: true, FontSize: 15);
          }

          Label {FlexWeight: 1;}

          $C.@CheckBoxWithLabel #ShowOnlyMyWarpsFilter {
            @Text = %extendedteleporters.gui.showOnlyMyWarps;
          }
        }

        $C.@DropdownBox #WarpDestinationDropdown {
          Anchor: (Height: 34);
          Style: (
            ...@DefaultDropdownBoxStyle,
            PanelAlign: Bottom,
            PanelOffset: 5,
            SearchInputStyle: DropdownBoxSearchInputStyle(
              Anchor: (Height: 18),
              Padding: (Left: 26, Right: 22),
              PlaceholderText: %server.customUI.searchPlaceholder,
              PlaceholderStyle: (TextColor: #3d5a85, RenderUppercase: true, FontSize: 13),
              Icon: (Texture: "Common/SearchIcon.png", Width: 14, Height: 14, Offset: 8),
              ClearButtonStyle: $C.@ClearButtonStyle
            )
          );
          ShowSearchInput: true;
        }
      }

      // === SETTINGS SECTION (scrollable) ===
      Group #SettingsSection {
        FlexWeight: 1;
        LayoutMode: Top;
        Anchor: (Top: 6, Bottom: 6);

        // Scrollable settings container
        Group #SettingsScrollArea {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Right: 8);

          // Public Destination Change Group (FIRST - most requested setting)
          Group #AllowPublicDestinationChangeGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 8);

            $C.@CheckBoxWithLabel #AllowPublicDestinationChangeSetting {
              @Text = %extendedteleporters.gui.allowPublicDestinationChange;
              Padding: (Bottom: 5);
            }
          }

          // Visibility dropdown
          Group #VisibilityGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 8);

            Label #VisibilityLabel {
              Text: %extendedteleporters.gui.visibility;
              Style: (RenderUppercase: true, FontSize: 13);
              Anchor: (Bottom: 3);
            }

            $C.@DropdownBox #VisibilityDropdown {
              Anchor: (Height: 30);
              Style: (...@DefaultDropdownBoxStyle, PanelAlign: Bottom, PanelOffset: 3);
            }
          }

          // Access Settings Group
          Group #AccessSettingsGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 6);

            $C.@CheckBoxWithLabel #PartyOnlySetting {
              @Text = %extendedteleporters.gui.partyOnly;
              Padding: (Bottom: 5);
            }

            $C.@CheckBoxWithLabel #RestrictedSetting {
              @Text = %extendedteleporters.gui.restricted;
              Padding: (Bottom: 5);
            }
          }

          // Protection Settings Group
          Group #ProtectionSettingsGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 6);

            $C.@CheckBoxWithLabel #InteractionLockedSetting {
              @Text = %extendedteleporters.gui.lockInteraction;
              Padding: (Bottom: 5);
            }

            $C.@CheckBoxWithLabel #BreakLockedSetting {
              @Text = %extendedteleporters.gui.lockBreaking;
              Padding: (Bottom: 5);
            }
          }

          // Display Settings Group
          Group #DisplaySettingsGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 6);

            $C.@CheckBoxWithLabel #DisplayWorldSetting {
              @Text = %extendedteleporters.gui.displayWorld;
              Padding: (Bottom: 5);
            }

            $C.@CheckBoxWithLabel #DisplayCoordinatesSetting {
              @Text = %extendedteleporters.gui.displayCoordinates;
              Padding: (Bottom: 5);
            }

            $C.@CheckBoxWithLabel #HideMapWaypointSetting {
              @Text = %extendedteleporters.gui.hideMapWaypoint;
              Padding: (Bottom: 5);
            }
          }

          // Special Modes Group
          Group #SpecialModesGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 6);

            $C.@CheckBoxWithLabel #SelfDestructSetting {
              @Text = %extendedteleporters.gui.selfDestruct;
              Padding: (Bottom: 3);
            }

            Label #SelfDestructTimer {
              Text: "";
              Style: (FontSize: 13, TextColor: #ff6600, RenderBold: true);
              Visible: false;
              Anchor: (Bottom: 5);
            }

            $C.@CheckBoxWithLabel #SingleUseSetting {
              @Text = %extendedteleporters.gui.singleUse;
              Padding: (Bottom: 3);
            }
          }
        }
      }

      // === INFO SECTION ===
      Group #InfoSection {
        LayoutMode: Top;
        Anchor: (Top: 4, Bottom: 8);

        Group {
          Anchor: (Height: 1, Bottom: 6);
          OutlineColor: #93844c;
          OutlineSize: 0.5;
        }

        Label #LocationLabel {
          Text: "";
          Style: (FontSize: 13, TextColor: #93844c);
          Anchor: (Bottom: 3);
        }

        Label #OwnerLabel {
          Text: "";
          Style: (FontSize: 13, TextColor: #93844c);
          Anchor: (Bottom: 3);
        }

        Label #ModLabel {
          Text: "MOD: Extended Teleporters";
          Style: (FontSize: 11, TextColor: #666666);
        }
      }

      // === ACTION BUTTONS ===
      Group #ButtonSection {
        LayoutMode: Right;

        $C.@TextButton #ManageTrustButton {
          Text: %extendedteleporters.gui.manageTrust;
          Padding: (Left: 10, Right: 10, Top: 5, Bottom: 5);
          Anchor: (Right: 8);
          Visible: false;
        }

        $C.@TextButton #SaveChangesButton {
          Text: %extendedteleporters.gui.saveChanges;
          Padding: (Left: 10, Right: 10, Top: 5, Bottom: 5);
          Anchor: (Right: 8);
        }

        $C.@CancelTextButton #CloseButton {
          Text: %extendedteleporters.gui.close;
          Padding: (Left: 10, Right: 10, Top: 5, Bottom: 5);
        }
      }
    }
  }
}

$C.@BackButton {}
