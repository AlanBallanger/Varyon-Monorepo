$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 860, Height: 820);

    #Title {
      Label #ShopTitle {
        Text: "BOUTIQUE";
        Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
      }
    }

    #Content {
      Padding: (Top: 4, Bottom: 10, Left: 10, Right: 10);
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 8);

        Group {
          LayoutMode: Top;
          Anchor: (Width: 220, Right: 8);

          Label {
            Text: "Nom affiché";
            Style: (FontSize: 10, TextColor: #96a9be);
            Anchor: (Bottom: 2);
          }
          TextField #DisplayNameInput {
            Value: "";
            Anchor: (Height: 26);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 6);
            Style: $C.@DefaultInputFieldStyle;
          }
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 91, Right: 8);

          Label {
            Text: "Nb objets / rotation";
            Style: (FontSize: 10, TextColor: #96a9be);
            Anchor: (Bottom: 2);
          }
          TextField #MaxVisibleInput {
            Value: "0";
            Anchor: (Height: 26);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 6);
            Style: $C.@DefaultInputFieldStyle;
          }
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 49, Right: 4);

          Label {
            Text: "Mult. min";
            Style: (FontSize: 10, TextColor: #96a9be);
            Anchor: (Bottom: 2);
          }
          TextField #PriceMultMinInput {
            Value: "1.0";
            Anchor: (Height: 26);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 6);
            Style: $C.@DefaultInputFieldStyle;
          }
        }

        Group {
          LayoutMode: Top;
          Anchor: (Width: 49);

          Label {
            Text: "Mult. max";
            Style: (FontSize: 10, TextColor: #96a9be);
            Anchor: (Bottom: 2);
          }
          TextField #PriceMultMaxInput {
            Value: "1.0";
            Anchor: (Height: 26);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 6);
            Style: $C.@DefaultInputFieldStyle;
          }
        }
      }

      Label {
        Text: "OBJETS ET SERVICES";
        Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00);
        Anchor: (Bottom: 4);
      }

      Group #ItemGridScroll {
        Anchor: (Height: 460, Bottom: 8);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: #0a0f17);
        Padding: (Full: 6);

        Label #ItemEmptyLabel {
          Anchor: (Height: 24);
          Visible: false;
          Text: "Aucun objet. Cliquez sur + pour en ajouter.";
          Style: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Group #ShopItemGrid {
          LayoutMode: Top;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 6);

        Label {
          FlexWeight: 1;
          Text: "MARCHANDS LIÉS";
          Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00, VerticalAlignment: Center);
        }

        $C.@TertiaryTextButton #BindNpcButton {
          @Text = "LIER UN NPC";
          @Anchor = (Width: 140, Height: 26);
        }
      }

      Group #MerchantListScroll {
        Anchor: (Height: 100, Bottom: 10);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: #0a0f17);
        Padding: (Full: 4);

        Label #MerchantEmptyLabel {
          Anchor: (Height: 24);
          Text: "Aucun marchand lié à cette boutique.";
          Style: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Group #MerchantList {
          LayoutMode: Top;
        }
      }

      $C.@SecondaryTextButton #BackToListButton {
        @Text = "RETOUR";
        @Anchor = (Width: 100, Height: 36);
      }
    }
  }
}

$C.@BackButton {}
