$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1040, Height: 780);

    #Title {
      Label #EditorTitle {
        Text: "OBJET";
        Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
      }
    }

    #Content {
      Padding: (Top: 4, Bottom: 10, Left: 10, Right: 10);
      LayoutMode: Top;

      Group #ColumnsRow {
        Anchor: (Height: 660, Bottom: 10);
        LayoutMode: Left;

        Group #IdentityColumn {
          Anchor: (Width: 380, Right: 8);
          LayoutMode: Top;

          Label {
            Text: "TYPE";
            Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Bottom: 8);
          }

          Group {
            LayoutMode: Left;
            Anchor: (Bottom: 10);

            Button #ModeItemButton {
              FlexWeight: 1;
              Anchor: (Height: 34, Right: 4);
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              TooltipText: "";
              Style: ButtonStyle(
                Default: (Background: (Color: #185a28)),
                Hovered: (Background: (Color: #286a38)),
                Pressed: (Background: (Color: #0f4018)),
                Sounds: $C.@ButtonSounds
              );
              Group {
                LayoutMode: Middle;
                Label {
                  Text: "OBJET";
                  Style: (FontSize: 13, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
            }

            Button #ModeCommandButton {
              FlexWeight: 1;
              Anchor: (Height: 34, Left: 4);
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              TooltipText: "";
              Style: ButtonStyle(
                Default: (Background: (Color: #185a28)),
                Hovered: (Background: (Color: #286a38)),
                Pressed: (Background: (Color: #0f4018)),
                Sounds: $C.@ButtonSounds
              );
              Group {
                LayoutMode: Middle;
                Label {
                  Text: "COMMANDE";
                  Style: (FontSize: 13, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
                }
              }
            }
          }

          Group #ItemModeGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 8);

            Label {
              Text: "Objet (choisi depuis votre inventaire)";
              Style: (FontSize: 11, TextColor: #96a9be);
              Anchor: (Bottom: 3);
            }
            Label #ItemIdLabel {
              Text: "(aucun objet sélectionné)";
              Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center);
              Anchor: (Height: 30, Bottom: 6);
              Background: (Color: #0d1520);
              Padding: (Left: 8);
            }
            $C.@TertiaryTextButton #PickItemButton {
              @Text = "CHOISIR DANS L'INVENTAIRE";
              @Anchor = (Height: 32);
            }
          }

          Group #CommandModeGroup {
            LayoutMode: Top;
            Anchor: (Bottom: 8);

            Label {
              Text: "Commande. Emplacements: {player} {uuid} {amount}";
              Style: (FontSize: 11, TextColor: #96a9be);
              Anchor: (Bottom: 3);
            }
            TextField #CommandInput {
              Value: "";
              Anchor: (Height: 28, Bottom: 6);
              Background: (Color: #0d1520);
              OutlineColor: #3a4a5a;
              OutlineSize: 1;
              Padding: (Left: 8);
              Style: $C.@DefaultInputFieldStyle;
            }

            Group {
              LayoutMode: Left;
              Anchor: (Bottom: 3);

              Button #CommandModeServerButton {
                FlexWeight: 1;
                Anchor: (Height: 26, Right: 3);
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                TooltipText: "";
                Style: ButtonStyle(
                  Default: (Background: (Color: #185a28)),
                  Hovered: (Background: (Color: #286a38)),
                  Pressed: (Background: (Color: #0f4018)),
                  Sounds: $C.@ButtonSounds
                );
                Group {
                  LayoutMode: CenterMiddle;
                  Anchor: (Full: 0);
                  Label {
                    Style: (...$C.@DefaultLabelStyle, FontSize: 11, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center);
                    Text: "SERVEUR";
                  }
                }
              }

              Button #CommandModePlayerButton {
                FlexWeight: 1;
                Anchor: (Height: 26, Left: 3);
                TextTooltipStyle: $C.@DefaultTextTooltipStyle;
                TooltipText: "";
                Style: ButtonStyle(
                  Default: (Background: (Color: #185a28)),
                  Hovered: (Background: (Color: #286a38)),
                  Pressed: (Background: (Color: #0f4018)),
                  Sounds: $C.@ButtonSounds
                );
                Group {
                  LayoutMode: CenterMiddle;
                  Anchor: (Full: 0);
                  Label {
                    Style: (...$C.@DefaultLabelStyle, FontSize: 11, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center);
                    Text: "JOUEUR";
                  }
                }
              }
            }

            Label #CommandModeHint {
              Text: "Exécutée par le serveur (console, toutes permissions).";
              Style: (FontSize: 9, TextColor: #7a9cc6, Wrap: true);
              Anchor: (Left: 0, Right: 0, Height: 22, Bottom: 8);
            }

            Label {
              Text: "Icône (choisie depuis votre inventaire)";
              Style: (FontSize: 11, TextColor: #96a9be);
              Anchor: (Bottom: 3);
            }
            Label #IconItemIdLabel {
              Text: "(aucune icône sélectionnée)";
              Style: (FontSize: 12, TextColor: #ffffff, VerticalAlignment: Center);
              Anchor: (Height: 30, Bottom: 6);
              Background: (Color: #0d1520);
              Padding: (Left: 8);
            }
            $C.@TertiaryTextButton #PickIconButton {
              @Text = "CHOISIR DANS L'INVENTAIRE";
              @Anchor = (Height: 32);
            }
          }

          Label {
            Text: "Nom affiché";
            Style: (FontSize: 11, TextColor: #96a9be);
            Anchor: (Bottom: 3);
          }
          TextField #NameInput {
            Value: "";
            Anchor: (Height: 28, Bottom: 10);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 8);
            Style: $C.@DefaultInputFieldStyle;
          }

          Label {
            Text: "Catégorie";
            Style: (FontSize: 11, TextColor: #96a9be);
            Anchor: (Bottom: 3);
          }
          DropdownBox #CategoryDropdown {
            Anchor: (Height: 28);
            Style: $C.@DefaultDropdownBoxStyle;
            Value: "";
            DropdownEntry { Value: ""; Text: "Divers"; }
          }
        }

        Group #PricingColumn {
          Anchor: (Width: 260, Right: 8);
          LayoutMode: Top;

          Label {
            Text: "STOCK";
            Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Bottom: 8);
          }

          Label {
            Text: "Quantité en stock par joueur (0 = illimité)";
            Style: (FontSize: 11, TextColor: #96a9be);
            Anchor: (Bottom: 3);
          }
          Group {
            LayoutMode: Left;
            Anchor: (Bottom: 16);

            Group {
              FlexWeight: 1;
              Anchor: (Right: 3);
              LayoutMode: Top;

              Label {
                Text: "Min";
                Style: (FontSize: 10, TextColor: #6b7f96);
                Anchor: (Height: 14, Bottom: 2);
              }
              TextField #StockMinInput {
                Value: "0";
                Anchor: (Height: 28);
                Background: (Color: #0d1520);
                OutlineColor: #3a4a5a;
                OutlineSize: 1;
                Padding: (Left: 8);
                Style: $C.@DefaultInputFieldStyle;
              }
            }

            Group {
              FlexWeight: 1;
              Anchor: (Left: 3);
              LayoutMode: Top;

              Label {
                Text: "Max";
                Style: (FontSize: 10, TextColor: #6b7f96);
                Anchor: (Height: 14, Bottom: 2);
              }
              TextField #StockMaxInput {
                Value: "0";
                Anchor: (Height: 28);
                Background: (Color: #0d1520);
                OutlineColor: #3a4a5a;
                OutlineSize: 1;
                Padding: (Left: 8);
                Style: $C.@DefaultInputFieldStyle;
              }
            }
          }

          Label {
            Text: "DEVISE";
            Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Bottom: 8);
          }
          DropdownBox #CurrencyDropdown {
            Anchor: (Height: 28, Bottom: 16);
            Style: $C.@DefaultDropdownBoxStyle;
            Value: "";
            DropdownEntry { Value: ""; Text: "Coins"; }
          }

          Label {
            Text: "PRIX";
            Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Bottom: 8);
          }
          Label {
            Text: "Prix fixe (vide = prix de rachat par défaut)";
            Style: (FontSize: 11, TextColor: #96a9be);
            Anchor: (Bottom: 3);
          }
          TextField #OverridePriceInput {
            Value: "";
            Anchor: (Height: 28);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 8);
            Style: $C.@DefaultInputFieldStyle;
          }
        }

        Group #PreviewColumn {
          FlexWeight: 1;
          LayoutMode: Top;

          Label {
            Text: "APERÇU EN DIRECT";
            Style: (FontSize: 12, RenderBold: true, TextColor: #ffaa00);
            Anchor: (Bottom: 8);
          }

          Group {
            LayoutMode: CenterMiddle;
            Anchor: (Height: 360);
            Background: (Color: #0a0f17);

            Group #PreviewContent {
              LayoutMode: Top;

              Group #PreviewIconWrap {
                Anchor: (Width: 140, Height: 140, Bottom: 10);
                LayoutMode: CenterMiddle;
                Background: (Color: #101823);
                Visible: false;

                ItemIcon #PreviewIcon {
                  Anchor: (Width: 96, Height: 96);
                }
              }

              Label #PreviewName {
                Anchor: (Width: 260, Height: 20, Bottom: 6);
                Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #f5e9d8, HorizontalAlignment: Center);
                Text: "(sans nom)";
              }

              Label #PreviewPrice {
                Anchor: (Width: 260, Height: 18);
                Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #f4c542, HorizontalAlignment: Center);
                Text: "0 Coins";
              }
            }
          }
        }
      }

      Group #ButtonSection {
        LayoutMode: Left;

        $C.@SecondaryTextButton #BackToShopButton {
          @Text = "RETOUR";
          @Anchor = (Width: 100, Height: 36);
        }

        $C.@CancelTextButton #DeleteItemButton {
          @Text = "SUPPRIMER";
          @Anchor = (Left: 8, Width: 120, Height: 36);
        }
      }
    }
  }
}

$C.@BackButton {}
