$C = "../../Common.ui";

$C.@PageOverlay #MarketRoot {
  LayoutMode: CenterMiddle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 680, Top: 40);

    #Title {
      Group {
        LayoutMode: Left;
        Anchor: (Full: 0);

        $C.@Title #MarketTitle { @Text = "BOUTIQUE"; }

        Group { FlexWeight: 1; }

        Label #PurchaseBonusLabel {
          Anchor: (Height: 20, Right: 10);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: #6fd67a, HorizontalAlignment: End);
          Text: "";
        }

        Label #WalletValue {
          Anchor: (Height: 20, Right: 36);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #f4c542, HorizontalAlignment: End);
          Text: "0 Coins";
        }
      }
    }

    #Content {
      LayoutMode: Left;
      Padding: (Full: 0);

      Group #CategoryColumn {
        Anchor: (Width: 150);
        Background: (Color: #101823);
        Padding: (Full: 8);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #CategoryList {
          LayoutMode: Top;
        }
      }

      Group #VSep1 {
        Anchor: (Width: 1);
        Background: (Color: #2a3a4d);
      }

      Group #ItemsColumn {
        FlexWeight: 1;
        Padding: (Top: 12, Bottom: 10, Left: 10, Right: 10);
        LayoutMode: Top;

        Group #RotationBanner {
          Anchor: (Left: 0, Right: 0, Height: 88, Bottom: 10);
          Background: (Color: #101823);
          LayoutMode: CenterMiddle;
          Padding: (Full: 8);

          Group {
            LayoutMode: Top;
            Anchor: (Width: 400);

            Label #RotationBannerTitle {
              Anchor: (Left: 0, Right: 0, Height: 20, Bottom: 4);
              Style: (...$C.@DefaultLabelStyle, FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #f4c542, HorizontalAlignment: Center);
              Text: "Rotation d'objets du jour";
            }

            Label #RotationBannerSubtitle {
              Anchor: (Left: 0, Right: 0, Height: 16, Bottom: 8);
              Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #7a9cc6, HorizontalAlignment: Center);
              Text: "De nouveaux objets disponibles chaque jour !";
            }

            Label #RotationBannerLabel {
              Anchor: (Left: 0, Right: 0, Height: 18);
              Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #96a9be, HorizontalAlignment: Center);
              Text: "Prochaine rotation dans : --";
            }
          }
        }

        Group #ItemGridScroll {
          Anchor: (Left: 0, Right: 0);
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;

          Group #ItemGrid {
            Anchor: (Left: 0, Right: 0);
            LayoutMode: Top;
            Padding: (Full: 0);
          }
        }
      }

      Group #VSep2 {
        Anchor: (Width: 1);
        Background: (Color: #2a3a4d);
      }

      Group #DetailColumn {
        Anchor: (Width: 310);
        Padding: (Full: 12);
        LayoutMode: Top;

        Group #DetailHeaderRow {
          Anchor: (Left: 0, Right: 0, Height: 78, Bottom: 16);
          LayoutMode: Left;

          Group #DetailIconWrap {
            Anchor: (Width: 64, Height: 64, Right: 12);
            LayoutMode: CenterMiddle;
            Visible: false;

            ItemIcon #DetailIcon {
              Anchor: (Width: 56, Height: 56);
            }
          }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #DetailName {
              Anchor: (Left: 0, Right: 0, Height: 20, Bottom: 4);
              Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #f5e9d8, HorizontalAlignment: Start);
              Text: "Sélectionnez un objet";
            }

            Label #DetailPriceLabel {
              Anchor: (Left: 0, Right: 0, Height: 20);
              Style: (...$C.@DefaultLabelStyle, FontSize: 15, RenderBold: true, TextColor: #f4c542, HorizontalAlignment: Start);
              Text: "";
            }

            Label #DetailStockLabel {
              Anchor: (Left: 0, Right: 0, Height: 16);
              Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #6fd67a, HorizontalAlignment: Start);
              Text: "";
            }
          }
        }

        Group #DetailSep {
          Anchor: (Left: 0, Right: 0, Height: 1, Bottom: 16);
          Background: (Color: #1b2533);
          Visible: false;
        }

        Group #DetailQtyRow {
          Anchor: (Left: 0, Right: 0, Height: 38, Bottom: 16);
          LayoutMode: Left;
          Visible: false;

          Button #DetailQtyMinus {
            Anchor: (Width: 38, Height: 38, Right: 6);
            Style: $C.@TertiaryButtonStyle;
            Group {
              LayoutMode: CenterMiddle;
              Anchor: (Full: 0);
              Label {
                Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f5e9d8, HorizontalAlignment: Center);
                Text: "-";
              }
            }
          }

          TextField #DetailQtyInput {
            FlexWeight: 1;
            Value: "1";
            Anchor: (Height: 38);
            Background: (Color: #0d1520);
            OutlineColor: #3a4a5a;
            OutlineSize: 1;
            Padding: (Left: 8);
            Style: $C.@DefaultInputFieldStyle;
          }

          Button #DetailQtyPlus {
            Anchor: (Width: 38, Height: 38, Left: 6);
            Style: $C.@TertiaryButtonStyle;
            Group {
              LayoutMode: CenterMiddle;
              Anchor: (Full: 0);
              Label {
                Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f5e9d8, HorizontalAlignment: Center);
                Text: "+";
              }
            }
          }

          $C.@TertiaryTextButton #DetailQtyMax {
            @Text = "MAX";
            @Anchor = (Width: 76, Height: 38, Left: 6);
          }
        }

        Group #DetailTotalCard {
          Anchor: (Left: 0, Right: 0, Height: 56, Bottom: 16);
          Background: (Color: #101823);
          Visible: false;

          Group {
            LayoutMode: Left;
            Anchor: (Full: 0);
            Padding: (Left: 14, Right: 14);

            Label #DetailTotalLabel {
              Anchor: (Height: 20, Right: 8);
              Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #7a9cc6, VerticalAlignment: Center, LetterSpacing: 1);
              Text: "TOTAL";
            }

            Label #DetailTotalValue {
              FlexWeight: 1;
              Anchor: (Height: 20);
              Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #f4c542, VerticalAlignment: Center, HorizontalAlignment: End);
              Text: "0";
            }
          }
        }

        Button #DetailBuyButton {
          Anchor: (Left: 0, Right: 0, Height: 48);
          Style: ButtonStyle(
            Default: (Background: (Color: #185a28)),
            Hovered: (Background: (Color: #286a38)),
            Pressed: (Background: (Color: #0f4018)),
            Sounds: $C.@ButtonSounds
          );
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
          TooltipText: "";
          Visible: false;

          Group {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);

            Label {
              Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center);
              Text: "ACHETER";
            }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
