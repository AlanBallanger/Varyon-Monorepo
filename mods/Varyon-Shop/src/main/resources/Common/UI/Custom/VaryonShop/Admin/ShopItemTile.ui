$C = "../../Common.ui";

Group #ShopTileRoot {
  Anchor: (Width: 100, Height: 112, Right: 8);

  Button #ShopTileButton {
    Anchor: (Full: 0);
    Style: $C.@TertiaryButtonStyle;
    TextTooltipStyle: $C.@DefaultTextTooltipStyle;
    TooltipText: "";

    Group {
      LayoutMode: Top;
      Anchor: (Full: 0);
      Padding: (Full: 6);

      Group #ShopTileIconWrap {
        Anchor: (Left: 0, Right: 0, Height: 60, Bottom: 4);
        LayoutMode: CenterMiddle;

        Group #ShopTileBg {
          Anchor: (Full: 0);
          Background: (Color: #101823);

          AssetImage #ShopTileRarityBg {
            Anchor: (Full: 0);
            Visible: false;
          }

          ItemIcon #ShopTileIcon {
            Anchor: (Width: 46, Height: 46);
          }
        }
      }

      Label #ShopTilePlus {
        Anchor: (Left: 0, Right: 0, Height: 60, Bottom: 4);
        Visible: false;
        Style: (...$C.@DefaultLabelStyle, FontSize: 32, RenderBold: true, TextColor: #7a9cc6, HorizontalAlignment: Center, VerticalAlignment: Center);
        Text: "+";
      }

      Label #ShopTileName {
        Anchor: (Height: 13, Bottom: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #c8d4e0, HorizontalAlignment: Center, Wrap: true, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 7);
        Text: "";
      }

      Label #ShopTilePrice {
        Anchor: (Height: 14);
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, RenderBold: true, TextColor: #f4c542, HorizontalAlignment: Center);
        Text: "";
      }
    }
  }
}
