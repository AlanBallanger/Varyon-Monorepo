              TextButton #AvailableAdd3 { Text: "ADD"; Style: @CrButtonGreenStyle; Anchor: (Width: 64, Height: 26, Vertical: 0); }
            }
            Group #AvailableRow4 { LayoutMode: Left; Anchor: (Height: 34, Bottom: 2); Background: (Color: @CrRowBg); Padding: (Left: 8, Right: 4, Top: 2, Bottom: 2);
