  // ===== EDIT POPUP (scope / permission for one restricted rule) =====
  Group #EditPopup {
    Anchor: (Full: 0);
    LayoutMode: Center;
    Background: (Color: #000000(0.55));
    Visible: false;

    Group #EditPopupCard {
      Anchor: (Width: 440, Height: 460);
      Background: (Color: #101a28);
      OutlineColor: #2a3a52;
      OutlineSize: 1;
      LayoutMode: Top;
      Padding: (Full: 16);

      Label #EditPopupTitle {
        Text: "";
        Style: (FontSize: 14, RenderBold: true, TextColor: #ffffff);
        Anchor: (Bottom: 12);
      }

      Label {
        Text: "Portee (tous ON = restreint partout, OFF = exclu)";
        Style: (FontSize: 11, TextColor: #96a9be);
        Anchor: (Bottom: 4);
      }

      Label #EditWorldsEmptyLabel {
        Text: "Aucun monde charge.";
        Style: (FontSize: 11, TextColor: #96a9be);
        Anchor: (Bottom: 4);
      }

      Group #EditWorldsScroll {
        Anchor: (Height: 180, Bottom: 12);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: @CrPanelBg);
        Padding: (Full: 4);

        Group #EditWorldsList {
          LayoutMode: Top;

            Button #EditWorldRow1 { FlexWeight: 0; Anchor: (Height: 30, Bottom: 3, Left: 0, Right: 0); Style: ButtonStyle(Default: (Background: (Color: #172639)), Hovered: (Background: (Color: #223247)), Sounds: $C.@ButtonSounds); Padding: (Left: 8, Right: 8);
              Group { LayoutMode: Left;
                Label #EditWorldName1 { FlexWeight: 1; Style: (TextColor: #ffffff, FontSize: 12, VerticalAlignment: Center); }
                Group #EditWorldBadgeOn1 { Anchor: (Width: 46, Height: 22, Vertical: 0); Background: (Color: #185a28); OutlineColor: #2fae52; OutlineSize: 1; LayoutMode: Middle; Visible: false;
                  Label { Text: "ON"; Style: (TextColor: #aaffaa, FontSize: 11, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                }
                Group #EditWorldBadgeOff1 { Anchor: (Width: 46, Height: 22, Vertical: 0); Background: (Color: #2a3243); OutlineColor: #3a4456; OutlineSize: 1; LayoutMode: Middle;
                  Label { Text: "OFF"; Style: (TextColor: #8a97a8, FontSize: 11, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                }
              }
            }
            Button #EditWorldRow2 { FlexWeight: 0; Anchor: (Height: 30, Bottom: 3, Left: 0, Right: 0); Style: ButtonStyle(Default: (Background: (Color: #172639)), Hovered: (Background: (Color: #223247)), Sounds: $C.@ButtonSounds); Padding: (Left: 8, Right: 8);
