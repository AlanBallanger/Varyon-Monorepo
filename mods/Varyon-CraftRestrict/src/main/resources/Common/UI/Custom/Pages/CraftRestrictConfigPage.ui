      }

      Group #EditPermissionBg {
        Background: (Color: @CrPanelBg);
        OutlineColor: #223247;
        OutlineSize: 1;
        Padding: (Left: 8, Right: 8);
        Anchor: (Height: 28, Bottom: 16);

        TextField #EditPermissionInput {
          Style: (FontSize: 12, TextColor: #ffffff);
          FlexWeight: 1;
        }
      }

      Group #EditPopupFooter {
        LayoutMode: Left;
        Anchor: (Height: 32);

        TextButton #EditCloseButton {
          Text: "ANNULER";
          Style: @CrButtonNeutralStyle;
          Anchor: (Width: 110, Height: 32, Right: 8);
        }

        Group { FlexWeight: 1; }

        TextButton #EditSaveButton {
          Text: "ENREGISTRER";
          Style: @CrButtonGreenStyle;
          Anchor: (Width: 130, Height: 32);
        }
      }
