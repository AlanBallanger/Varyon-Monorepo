                Label #EditWorldName2 { FlexWeight: 1; Style: (TextColor: #ffffff, FontSize: 12, VerticalAlignment: Center); }
                Group #EditWorldBadgeOn2 { Anchor: (Width: 46, Height: 22, Vertical: 0); Background: (Color: #185a28); OutlineColor: #2fae52; OutlineSize: 1; LayoutMode: Middle; Visible: false;
                  Label { Text: "ON"; Style: (TextColor: #aaffaa, FontSize: 11, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                }
                Group #EditWorldBadgeOff2 { Anchor: (Width: 46, Height: 22, Vertical: 0); Background: (Color: #2a3243); OutlineColor: #3a4456; OutlineSize: 1; LayoutMode: Middle;
                  Label { Text: "OFF"; Style: (TextColor: #8a97a8, FontSize: 11, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }
                }
