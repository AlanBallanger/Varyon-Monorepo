            Button #EditWorldRow3 { FlexWeight: 0; Anchor: (Height: 30, Bottom: 3, Left: 0, Right: 0); Style: ButtonStyle(Default: (Background: (Color: #172639)), Hovered: (Background: (Color: #223247)), Sounds: $C.@ButtonSounds); Padding: (Left: 8, Right: 8);
