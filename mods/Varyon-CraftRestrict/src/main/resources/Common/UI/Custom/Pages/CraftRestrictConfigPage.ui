$C = "../Common.ui";

@CrRowBg = #172639;
@CrPanelBg = #0a0f17;
@CrCardBg = #101a28;

@CrButtonRedStyle = TextButtonStyle(
  Default: (Background: (Color: #7a2b2b), LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: (Color: #933737), LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (Color: #5e2020), LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

@CrButtonGreenStyle = TextButtonStyle(
  Default: (Background: (Color: #185a28), LabelStyle: (FontSize: 12, TextColor: #aaffaa, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: (Color: #286a38), LabelStyle: (FontSize: 12, TextColor: #aaffaa, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (Color: #0f4018), LabelStyle: (FontSize: 12, TextColor: #aaffaa, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

@CrButtonNeutralStyle = TextButtonStyle(
  Default: (Background: (Color: #2b3f66), LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (Background: (Color: #35507f), LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (Background: (Color: #233553), LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Sounds: $C.@ButtonSounds
);

Group #Root {
  Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
  LayoutMode: Full;

  Group #CardWrap {
    Anchor: (Full: 0);
    LayoutMode: Center;

  Group #Card {
    Anchor: (Width: 900, Height: 620);
    Background: (Color: #0d1420ee);
    OutlineColor: #2a3a52;
    OutlineSize: 1;
    LayoutMode: Top;

    // === Header ===
    Group #Header {
      LayoutMode: Left;
      Background: (Color: #0a0f17);
      Padding: (Left: 16, Right: 16, Top: 10, Bottom: 10);
      Anchor: (Height: 44);

      Label #Title {
        Text: "CRAFTRESTRICT";
        Style: (FontSize: 16, RenderBold: true, TextColor: #ffffff);
        FlexWeight: 1;
        Anchor: (Vertical: 0);
      }

      TextButton #CloseButton {
        Text: "X";
        Style: @CrButtonRedStyle;
        Anchor: (Width: 26, Height: 26, Vertical: 0);
      }
    }

    // === Body: two columns ===
    Group #Body {
      LayoutMode: Left;
      Padding: (Top: 10, Bottom: 10, Left: 10, Right: 10);
      FlexWeight: 1;

      // ===== LEFT COLUMN: AVAILABLE ITEMS =====
      Group #LeftColumn {
        FlexWeight: 1;
        LayoutMode: Top;
        Anchor: (Right: 6);

        Label {
          Text: "OBJETS DISPONIBLES";
          Style: (FontSize: 12, RenderBold: true, TextColor: #96a9be);
          Anchor: (Bottom: 6);
        }

        Group #AvailableSearchBg {
          Background: (Color: @CrPanelBg);
          OutlineColor: #223247;
          OutlineSize: 1;
          Padding: (Left: 8, Right: 8);
          Anchor: (Height: 28, Bottom: 8);

          TextField #AvailableSearchInput {
            Style: (FontSize: 12, TextColor: #ffffff);
            FlexWeight: 1;
          }
        }

        Group #AvailableScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Background: (Color: @CrPanelBg);
          Padding: (Full: 4);

          Group #AvailableList {
            LayoutMode: Top;

            Group #AvailableRow1 { LayoutMode: Left; Anchor: (Height: 34, Bottom: 2); Background: (Color: @CrRowBg); Padding: (Left: 8, Right: 4, Top: 2, Bottom: 2);
              Label #AvailableLabel1 { FlexWeight: 1; Style: (TextColor: #ffffff, FontSize: 12, VerticalAlignment: Center); }
              TextButton #AvailableAdd1 { Text: "ADD"; Style: @CrButtonGreenStyle; Anchor: (Width: 64, Height: 26, Vertical: 0); }
            }
            Group #AvailableRow2 { LayoutMode: Left; Anchor: (Height: 34, Bottom: 2); Background: (Color: @CrRowBg); Padding: (Left: 8, Right: 4, Top: 2, Bottom: 2);
              Label #AvailableLabel2 { FlexWeight: 1; Style: (TextColor: #ffffff, FontSize: 12, VerticalAlignment: Center); }
              TextButton #AvailableAdd2 { Text: "ADD"; Style: @CrButtonGreenStyle; Anchor: (Width: 64, Height: 26, Vertical: 0); }
            }
            Group #AvailableRow3 { LayoutMode: Left; Anchor: (Height: 34, Bottom: 2); Background: (Color: @CrRowBg); Padding: (Left: 8, Right: 4, Top: 2, Bottom: 2);
