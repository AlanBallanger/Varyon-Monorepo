            Group #AvailableRow13 { LayoutMode: Left; Anchor: (Height: 34, Bottom: 2); Background: (Color: @CrRowBg); Padding: (Left: 8, Right: 4, Top: 2, Bottom: 2);
              Label #AvailableLabel13 { FlexWeight: 1; Style: (TextColor: #ffffff, FontSize: 12, VerticalAlignment: Center); }
              TextButton #AvailableAdd13 { Text: "ADD"; Style: @CrButtonGreenStyle; Anchor: (Width: 64, Height: 26, Vertical: 0); }
            }
            Group #AvailableRow14 { LayoutMode: Left; Anchor: (Height: 34, Bottom: 2); Background: (Color: @CrRowBg); Padding: (Left: 8, Right: 4, Top: 2, Bottom: 2);
              Label #AvailableLabel14 { FlexWeight: 1; Style: (TextColor: #ffffff, FontSize: 12, VerticalAlignment: Center); }
              TextButton #AvailableAdd14 { Text: "ADD"; Style: @CrButtonGreenStyle; Anchor: (Width: 64, Height: 26, Vertical: 0); }
            }
          }
        }
      }

      // ===== RIGHT COLUMN: RESTRICTED ITEMS =====
      Group #RightColumn {
        FlexWeight: 1;
        LayoutMode: Top;
        Anchor: (Left: 6);

        Group #TabBar {
          LayoutMode: Left;
          Anchor: (Height: 30, Bottom: 8);

          TextButton #TabCraftButton {
            Text: "CRAFT / ETABLI";
            Style: @CrButtonNeutralStyle;
            FlexWeight: 1;
            Anchor: (Height: 28, Right: 3);
          }
          TextButton #TabPossessionButton {
            Text: "POSSESSION";
            Style: @CrButtonNeutralStyle;
            FlexWeight: 1;
            Anchor: (Height: 28, Left: 3);
          }
        }

        Group #CraftTab {
