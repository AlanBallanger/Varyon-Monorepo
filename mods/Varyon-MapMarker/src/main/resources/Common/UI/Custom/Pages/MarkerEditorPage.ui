$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;
}

$C.@Container {
  Anchor: (Width: 700, Height: 680);

  #Title {
    $C.@Title {
      @Text = "ÉDITEUR DE MARQUEUR";
    }
  }

  #Content {
    LayoutMode: Top;

    Group #InfoSection {
      LayoutMode: Top;
      Anchor: (Bottom: 8);

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 4);

        Label {
          Text: "Nom :";
          Style: (RenderBold: true, TextColor: #96a9be, VerticalAlignment: Center);
          Anchor: (Width: 48);
        }

        $C.@TextField #MarkerNameInput {
          @Anchor = (Height: 28);
          FlexWeight: 1;
        }

        $C.@TertiaryTextButton #RenameButton {
          @Text = "OK";
          @Anchor = (Width: 48, Height: 28, Left: 6);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 6);

        Label {
          Text: "Groupe :";
          Style: (RenderBold: true, TextColor: #96a9be, VerticalAlignment: Center);
          Anchor: (Width: 60);
        }

        $C.@TextField #MarkerGroupInput {
          @Anchor = (Height: 28);
          FlexWeight: 1;
        }

        $C.@TertiaryTextButton #SetGroupButton {
          @Text = "OK";
          @Anchor = (Width: 48, Height: 28, Left: 6);
        }
      }

      Group #PositionControls {
        LayoutMode: Left;
        Anchor: (Bottom: 4);

        Label {
          Text: "Position";
          Style: (RenderBold: true, TextColor: #96a9be, VerticalAlignment: Center);
          Anchor: (Width: 60);
        }

        Label {
          Text: "X";
          Style: (TextColor: #ff6666, VerticalAlignment: Center);
          Anchor: (Width: 14);
        }

        $C.@SmallSecondaryTextButton #XDownButton {
          @Text = "-";
          @Anchor = (Width: 26, Height: 26);
        }

        Label #PosXLabel {
          Text: "0";
          Style: (TextColor: #ffffff, FontSize: 13, HorizontalAlignment: Center, VerticalAlignment: Center);
          Anchor: (Width: 56, Height: 26);
        }

        $C.@SmallSecondaryTextButton #XUpButton {
          @Text = "+";
          @Anchor = (Width: 26, Height: 26, Right: 10);
        }

        Label {
          Text: "Z";
          Style: (TextColor: #6666ff, VerticalAlignment: Center);
          Anchor: (Width: 14, Left: 2);
        }

        $C.@SmallSecondaryTextButton #ZDownButton {
          @Text = "-";
          @Anchor = (Width: 26, Height: 26);
        }

        Label #PosZLabel {
          Text: "0";
          Style: (TextColor: #ffffff, FontSize: 13, HorizontalAlignment: Center, VerticalAlignment: Center);
          Anchor: (Width: 56, Height: 26);
        }

        $C.@SmallSecondaryTextButton #ZUpButton {
          @Text = "+";
          @Anchor = (Width: 26, Height: 26, Right: 10);
        }

        $C.@TextButton #MoveHereButton {
          @Text = "DÉPLACER ICI";
          @Anchor = (Width: 130, Height: 26);
        }
      }
    }

    Label {
      Text: "ICÔNE";
      Style: (RenderBold: true, RenderUppercase: true, TextColor: #ffaa00);
      Anchor: (Bottom: 4);
    }

    Group #ImagePickContainer {
      Background: (Color: #0a0f17);
      Anchor: (Height: 300, Bottom: 8);
      Padding: 4;

      Group #ImagePickList {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    Group #ButtonSection {
      LayoutMode: Left;

      $C.@SecondaryTextButton #BackToListButton {
        @Text = "RETOUR";
        @Anchor = (Width: 100, Height: 36);
      }

      $C.@CancelTextButton #DeleteButton {
        @Text = "SUPPRIMER";
        @Anchor = (Left: 8, Width: 120, Height: 36);
      }

      $C.@SecondaryTextButton #ExitButton {
        @Text = "FERMER";
        @Anchor = (Left: 8, Width: 90, Height: 36);
      }
    }
  }
}

$C.@BackButton {}
