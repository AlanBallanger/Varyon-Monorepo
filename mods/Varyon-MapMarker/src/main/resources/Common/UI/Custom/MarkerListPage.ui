$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 640, Height: 680);

    #Title {
      Group {
        LayoutMode: Left;

        Label {
          FlexWeight: 1;
          Text: "MARQUEURS";
          Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center, HorizontalAlignment: Center);
        }

        TextButton #ListCloseButton {
          Text: "X";
          Anchor: (Width: 24, Height: 24, Top: 2, Right: 8);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
          );
        }
      }
    }

    #Content {
      Padding: (Top: 4, Bottom: 10, Left: 10, Right: 10);
      LayoutMode: Top;

      Label #EmptyLabel {
        Anchor: (Height: 24, Bottom: 4);
        Text: "Aucun marqueur dans ce monde.";
        Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
      }

      Group #ListScroll {
        Anchor: (Height: 420);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: (Color: #0a0f17);
        Padding: (Full: 4);

        Group #MarkerList {
          LayoutMode: Top;
        }
      }

      Group { Anchor: (Height: 8); }

      Group {
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        Label {
          Text: "Image (nom du fichier PNG dans images/, ex: MonIcone.png)";
          Style: (FontSize: 12, TextColor: #96a9be);
          Anchor: (Bottom: 3);
        }

        $C.@TextField #CreateImageInput {
          @Anchor = (Height: 30, Bottom: 6);
        }

        Label {
          Text: "Nom du marqueur";
          Style: (FontSize: 12, TextColor: #96a9be);
          Anchor: (Bottom: 3);
        }

        $C.@TextField #CreateNameInput {
          @Anchor = (Height: 30);
        }
      }

      Button #CreateButton {
        Anchor: (Left: 0, Right: 0, Height: 40, Top: 6);
        Style: ButtonStyle(
          Default: (Background: (Color: #185a28)),
          Hovered: (Background: (Color: #286a38)),
          Pressed: (Background: (Color: #0f4018))
        );
        OutlineColor: #083818;
        OutlineSize: 1;
        Group {
          LayoutMode: Middle;
          Label {
            Text: "CRÉER UN MARQUEUR ICI";
            Style: (FontSize: 13, RenderBold: true, TextColor: #aaffaa, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }
    }
  }
}
