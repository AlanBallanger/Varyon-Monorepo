$C = "Common.ui";

@PageWidth = 1040;
@PageHeight = 740;

@Ink = #E8DCC8;
@InkMuted = #A89E90;
@Gold = #D4AF37(0.92);
@CardBg = #1C1A15;
@CardBgReady = #3A2F16;
@CardBgDone = #1E3A24;
@CardBgProgress = #1E2E4A;
@Veil = #0A0A0A(0.72);
@Backdrop = #000000(0.5);
@Rail = #E8DCC8(0.22);
@SidebarBg = #14120E;
@SidebarLine = #E8DCC8(0.18);

@TitleStyle = (FontSize: 20, TextColor: @Ink, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
@NameStyle = (FontSize: 13, TextColor: @Ink, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
@BonusStyle = (FontSize: 10, TextColor: @Gold, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
@CostStyle = (FontSize: 12, TextColor: @Gold, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
@ItemStyle = (FontSize: 10, TextColor: @InkMuted, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
@TimeStyle = (FontSize: 11, TextColor: @InkMuted, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
@TierStyle = (FontSize: 14, TextColor: @Ink, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);

@NodeBtn = (
  Default: ( Background: #000000(0.0) ),
  Hovered: ( Background: #FFFFFF(0.08) ),
  Pressed: ( Background: #FFFFFF(0.14) ),
  Disabled: ( Background: #000000(0.0) ),
  Sounds: $C.@ButtonSounds
);

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  Background: @Backdrop;
  LayoutMode: Middle;

  Group {
    Anchor: (Width: @PageWidth, Height: @PageHeight);
    Background: PatchStyle(TexturePath: "Common/ContainerFullPatch.png", Border: 20, Color: #FFFFFFE6);
    LayoutMode: Top;
    Padding: (Full: 18);

    Label #ResearchTreeTitle { Anchor: (Left: 0, Right: 0, Height: 28); Style: @TitleStyle; Text: "Arbre de recherche"; }
    Group { Anchor: (Height: 8); }

    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      Group #ResearchTreeCanvas { Anchor: (Width: 920, Height: 2180); LayoutMode: Full;

      Group #ResearchEdgeSeg0 { Anchor: (Left: 0, Top: 0, Width: 3, Height: 3); Background: @Rail; Visible: false; }
      Group #ResearchEdgeSeg1 { Anchor: (Left: 0, Top: 0, Width: 3, Height: 3); Background: @Rail; Visible: false; }
