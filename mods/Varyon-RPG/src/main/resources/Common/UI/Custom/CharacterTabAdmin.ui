$C = "Common.ui";

@AdminButtonStyle = (
  Default: (Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)),
  Hovered: (Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)),
  Pressed: (Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)),
  Disabled: (Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)),
  Sounds: $C.@ButtonSounds
);

@AdminLabelStyle = (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center);

@AdminSubTabButtonStyle = (
  Default: (Background: #000000(0.0)),
  Hovered: (Background: #FFFFFF(0.08)),
  Pressed: (Background: #FFFFFF(0.12))
);

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;
  Padding: (Full: 16);

  Group {
    Anchor: (Left: 0, Right: 0, Height: 36);
    LayoutMode: Left;

    Label { Anchor: (Height: 36); Style: @AdminLabelStyle; Text: "Joueur cible :"; }
    Group { Anchor: (Width: 10); }

    Button #AdminPlayerPrev {
      Anchor: (Width: 32, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle;
      Label { Style: (FontSize: 14, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "<"; }
    }
    Group { Anchor: (Width: 6); }

    Group {
      Anchor: (Width: 200, Height: 30); LayoutMode: Full; Background: #000000(0.30);
      Label #AdminTargetName {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        Text: "—";
      }
    }

    Group { Anchor: (Width: 6); }
    Button #AdminPlayerNext {
      Anchor: (Width: 32, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle;
      Label { Style: (FontSize: 14, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ">"; }
    }
    Group { Anchor: (Width: 10); }
    Button #AdminPlayerSelf {
      Anchor: (Width: 60, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle;
      Label { Style: (FontSize: 11, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "MOI"; }
    }
    Group { Anchor: (Width: 10); }
    Label #AdminPlayerCount {
      Anchor: (Height: 36);
      Style: (FontSize: 11, TextColor: #787060, VerticalAlignment: Center);
      Text: "";
    }
  }

  Group { Anchor: (Height: 14); }

  Group {
    Anchor: (Left: 0, Right: 0, Height: 34);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 130, Height: 34);
      LayoutMode: Top;

      Button #AdminSubTabProfessions {
        Anchor: (Left: 0, Right: 0, Height: 28); Style: @AdminSubTabButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Professions"; }
      }
      Group #AdminSubTabProfessionsUnderline {
        Anchor: (Left: 0, Right: 0, Height: 2); Background: #C8A96E;
      }
    }

    Group { Anchor: (Width: 12); }

    Group {
      Anchor: (Width: 110, Height: 34);
      LayoutMode: Top;

      Button #AdminSubTabClasses {
        Anchor: (Left: 0, Right: 0, Height: 28); Style: @AdminSubTabButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Classes"; }
      }
      Group #AdminSubTabClassesUnderline {
        Anchor: (Left: 0, Right: 0, Height: 2); Background: #C8A96E; Visible: false;
      }
    }
  }

  Group { Anchor: (Height: 12); }

  Group #AdminContentMount {
    Anchor: (Left: 0, Right: 0);
    LayoutMode: Top;
  }
}
