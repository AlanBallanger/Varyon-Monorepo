$P = "CharacterPage.ui";

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Group {
    Anchor: (Left: 0, Right: 0, Height: 36);
    LayoutMode: Left;

    Button #ClassProfilesBackButton {
      Anchor: (Width: 120, Top: 0, Bottom: 0);
      Style: $P.@PlusButtonStyle;
      LayoutMode: Left;
      Group { FlexWeight: 1; }
      Group { Anchor: (Width: 14, Height: 14); Background: PatchStyle(TexturePath: "Elements/Return.png", Border: 0); }
      Group { Anchor: (Width: 6); }
      Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Retour"; }
      Group { FlexWeight: 1; }
    }

    Group { FlexWeight: 1; }

    Label {
      Anchor: (Height: 36);
      Style: (FontSize: 22, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, HorizontalAlignment: Center);
      Text: "Profils de classe";
    }

    Group { FlexWeight: 1; }
  }

  Group { Anchor: (Height: 12); }

  Group {
    Anchor: (Left: 0, Right: 0, Height: 1);
    Background: #E8DCC8(0.16);
  }

  Group { Anchor: (Height: 12); }

  Group {
    FlexWeight: 1;
    Anchor: (Left: 0, Right: 0);
    LayoutMode: Left;

    Group #ClassProfile0Card {
      FlexWeight: 1;
      LayoutMode: Full;
      Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

      Button #ClassProfile0HoverButton {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        Style: (
          Default: (Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10, Color: #FFFFFF(0.0))),
          Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
          Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10))
        );
      }

      Group {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Top;
        Padding: (Full: 10);

      Group {
        Anchor: (Left: 0, Right: 0, Height: 20);
        LayoutMode: Center;

        Group #ClassProfile0ActiveBadge {
          Background: #25793C(1.0);
          Padding: (Horizontal: 6, Vertical: 2);
          Visible: false;
          Label { Style: (FontSize: 11, TextColor: #FFFFFF, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center); Text: "Actif"; }
        }

        Group #ClassProfile0InactiveBadge {
          Background: #3A3530(1.0);
          Padding: (Horizontal: 6, Vertical: 2);
          Visible: true;
          Label { Style: (FontSize: 11, TextColor: #A89E90, RenderUppercase: true, VerticalAlignment: Center); Text: "Inactif"; }
        }
      }

      Group { Anchor: (Height: 6); }

      Label #ClassProfile0Name {
        Anchor: (Left: 0, Right: 0, Height: 20);
        Style: (FontSize: 15, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
        Text: "Profil 1";
      }

      Group { Anchor: (Height: 8); }

      Group {
        Anchor: (Left: 0, Right: 0, Height: 52);
        LayoutMode: Middle;
        ItemIcon #ClassProfile0ClassIcon { Anchor: (Width: 48, Height: 48); }
      }

      Group { Anchor: (Height: 6); }

      Label #ClassProfile0ClassName {
        Anchor: (Left: 0, Right: 0, Height: 18);
        Style: (FontSize: 13, TextColor: #C8BEB0, HorizontalAlignment: Center);
        Text: "Aucune classe";
      }

      Label #ClassProfile0SpecName {
        Anchor: (Left: 0, Right: 0, Height: 16);
        Style: (FontSize: 12, TextColor: #6BCB7A, HorizontalAlignment: Center);
        Text: "";
      }
      }

      Group #ClassProfile0ConfirmPanel {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Middle;
        Background: #000000(0.72);
        Visible: false;

        Button #ClassProfile0ConfirmButton {
          Anchor: (Width: 120, Height: 36);
          Style: (
            Default: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10)),
            Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
            Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10))
          );
          LayoutMode: Middle;
          Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Confirmer"; }
        }
      }
    }

    Group { Anchor: (Width: 8, Top: 0, Bottom: 0); }

    Group #ClassProfile1Card {
      FlexWeight: 1;
      LayoutMode: Full;
