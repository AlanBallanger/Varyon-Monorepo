        Group {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Top;

      Label {
        Style: @SectionTitleStyle;
        Text: "Talent";
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 10);

