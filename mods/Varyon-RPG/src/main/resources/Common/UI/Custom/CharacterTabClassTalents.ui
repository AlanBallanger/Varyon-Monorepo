$C = "Common.ui";

@Ink = #E8DCC8;
@InkStrong = #F2E8D8;
@InkMuted = #C8BEB0;
@InkFaint = #A89E90;
@LeatherBg = #000000(0.22);
@PanelShade = #000000(0.32);
@CardShade = #000000(0.26);
@Gold = #D4AF37(0.92);
@GoldSoft = #D4AF37(0.74);
@GoldHighlight = #F7E6A5(0.62);
@GoldShadow = #1A1612(0.55);
@ActiveGreen = #6BCB7A(0.95);
@Aging = #8A7A5A(0.22);
@ParchmentMottle = #FFFFFF(0.03);
@GrainLight = #FFFFFF(0.02);
@GrainDark = #000000(0.12);
@Edge1 = #FFFFFF(0.05);
@Edge2 = #FFFFFF(0.03);
@Edge3 = #000000(0.20);
@Divider = #E8DCC8(0.16);
@DividerSoft = #E8DCC8(0.10);
@Backdrop = #000000(0.42);
@SelectedButtonFill = #D4AF37(0.38);
@StatusPillBg = #000000(0.40);
@StatusPillEdge = #D4AF37(0.35);
@SkillTreeEdgeGlow = #D4AF37(0.62);
@SkillTreeNodeGlow = #D4AF37(0.18);

@HeadingStyle = (
  FontSize: 24,
  TextColor: @Ink,
  RenderBold: true
);

@SubHeadingStyle = (
  FontSize: 18,
  TextColor: @InkStrong,
  RenderBold: true
);

@MetaStyle = (
  FontSize: 16,
  TextColor: @InkMuted
);

@SectionTitleStyle = (
  FontSize: 16,
  TextColor: #C8A96E,
  RenderUppercase: true,
  RenderBold: true
);

@StatLabelStyle = (
  FontSize: 16,
  TextColor: #B8A88C,
  RenderUppercase: true
);

@ReadableStatLabelStyle = (
  ...@StatLabelStyle,
  RenderUppercase: false
);

@StatValueStyle = (
  FontSize: 18,
  TextColor: @InkStrong,
  RenderBold: true
);

@PlusButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  ),
  Sounds: $C.@ButtonSounds
);

@SkillSlotButtonStyle = (
  Default:  (Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0)),
  Hovered:  (Background: PatchStyle(TexturePath: "Elements/Add_Skill_Hovered.png", Border: 0)),
  Pressed:  (Background: PatchStyle(TexturePath: "Elements/Add_Skill_Hovered.png", Border: 0)),
  Disabled: (Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0)),
  Sounds: $C.@ButtonSounds
);

@BlockedButtonStyle = (
  Default: (
    Background: #6B4E2E(0.06)
  ),
  Hovered: (
    Background: #6B4E2E(0.06)
  ),
  Pressed: (
    Background: #6B4E2E(0.06)
  ),
  Disabled: (
    Background: #6B4E2E(0.06)
  ),
  Sounds: $C.@ButtonSounds
);

@TabButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  ),
  Sounds: $C.@ButtonSounds
);

@TabLabelStyle = (
  FontSize: 14,
  TextColor: @InkStrong,
  RenderUppercase: true,
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@CycleCardTitleStyle = (
  FontSize: 12,
  TextColor: @InkMuted,
  RenderUppercase: true,
  RenderBold: true
);

@CycleActiveTagStyle = (
  FontSize: 12,
  TextColor: @ActiveGreen,
  RenderUppercase: true,
  RenderBold: true
);

@CycleSlotKeyStyle = (
  FontSize: 10,
  TextColor: @InkMuted,
  RenderUppercase: true,
  RenderBold: true,
  VerticalAlignment: Center
);

@CycleSlotValueStyle = (
  FontSize: 12,
  TextColor: @InkStrong,
  RenderBold: true,
  VerticalAlignment: Center
);

@CycleSlotButtonStyle = (
  Default: (
    Background: @PanelShade
  ),
  Hovered: (
    Background: #6B4E2E(0.12)
  ),
  Pressed: (
    Background: #6B4E2E(0.16)
  ),
  Disabled: (
    Background: #6B4E2E(0.06)
  ),
  Sounds: $C.@ButtonSounds
);

@SkillNodeButtonStyle = (
  Default: (
    Background: #000000(0.0)
  ),
  Hovered: (
    Background: #000000(0.0)
  ),
  Pressed: (
    Background: #000000(0.0)
  ),
  Disabled: (
    Background: #000000(0.0)
  ),
  Sounds: $C.@ButtonSounds
);


@SkillNodeSlotStyle = (
  Default: (
    Background: #000000(0.0)
  ),
  Hovered: (
    Background: #000000(0.0)
  ),
  Pressed: (
    Background: #000000(0.0)
  ),
  Disabled: (
    Background: #000000(0.0)
  )
);

@PageWidth = 1170;
@PageHeight = 768;
@PagePadding = 31;


Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Group {
    Anchor: (Left: 0, Right: 0, Height: 48);
    LayoutMode: Full;
    Padding: (Left: 8, Top: 4, Right: 8);

    Group {
      Anchor: (Left: 0, Top: 0, Width: 500, Height: 44);
      LayoutMode: Full;

      Label #ClassTreeMainTitle {
        Anchor: (Left: 0, Top: 0, Right: 0, Height: 22);
        Style: @SectionTitleStyle;
        Text: "Arbre de talents de classe";
      }

      Label #ClassTreePointsLabel {
        Anchor: (Left: 0, Top: 24, Right: 0, Height: 18);
        Style: (...@MetaStyle, FontSize: 13, TextColor: @InkMuted, RenderBold: true);
        Text: "Points restants : 0";
      }

    }

    Group {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      LayoutMode: Middle;

      Group {
        Anchor: (Width: 240, Height: 30);
        LayoutMode: Left;

        Button #ClassTreeTabTalentsButton {
          Anchor: (Width: 116, Height: 30);
          Style: @TabButtonStyle;
          LayoutMode: Left;
          Group #ClassTreeTabTalentsUnderline {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8, Color: #D4AF37(0.72));
            Visible: true;
          }
          Group { FlexWeight: 1; }
          Label { Style: @TabLabelStyle; Text: "Talents"; }
          Group { FlexWeight: 1; }
        }

        Group { Anchor: (Width: 8); }

        Button #ClassTreeTabSkillsButton {
          Anchor: (Width: 116, Height: 30);
          Style: @TabButtonStyle;
          LayoutMode: Left;
          Group #ClassTreeTabSkillsUnderline {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8, Color: #D4AF37(0.72));
            Visible: false;
          }
          Group { FlexWeight: 1; }
          Label { Style: @TabLabelStyle; Text: "Compétences"; }
          Group { FlexWeight: 1; }
        }
      }
    }

    Group #ClassTreeProfessionPickerRow {
      Anchor: (Right: 0, Top: 11, Width: 140, Height: 26);
      LayoutMode: Full;
      Visible: true;

      Button #ClassTreeBackButton {
        Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
        Style: @CycleSlotButtonStyle;
        LayoutMode: Middle;
        Label {
          Style: (FontSize: 12, TextColor: @InkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "Retour";
        }
      }
    }
  }

  Group #ClassTreeTalentsPanel {
    FlexWeight: 1;
    Anchor: (Left: 0, Right: 0);
    LayoutMode: Full;
    Visible: true;

  Group #ClassTreeCanvas {
    Anchor: (Left: 0, Top: 0, Bottom: 0, Right: 298);
    LayoutMode: Full;

      Group #ClassTreePager {
        Anchor: (Right: 0, Top: 0, Width: 64, Height: 90);
        LayoutMode: Full;
        Background: @PanelShade;
        Padding: (Full: 6);
        Visible: false;

        Button #ClassTreePageUpButton {
          Anchor: (Left: 6, Right: 6, Top: 6, Height: 22);
          Style: @PlusButtonStyle;

          Label {
            Style: (FontSize: 16, TextColor: @InkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "^";
          }
        }

        Label #ClassTreePageLabel {
          Anchor: (Left: 0, Right: 0, Top: 37, Height: 16);
          Style: (...@MetaStyle, FontSize: 12, HorizontalAlignment: Center);
          Text: "";
        }

        Button #ClassTreePageDownButton {
          Anchor: (Left: 6, Right: 6, Bottom: 6, Height: 22);
          Style: @PlusButtonStyle;

          Label {
            Style: (FontSize: 16, TextColor: @InkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "v";
          }
        }
      }

      Group #ClassTreeSpecializationWipRect { Anchor: (Left: 0, Top: 0, Width: 720, Height: 34); Background: @CardShade; Visible: false; }
      Label #ClassTreeSpecializationWipLabel { Anchor: (Left: 0, Top: 0, Width: 720, Height: 34); Style: (...@MetaStyle, FontSize: 14, TextColor: @InkMuted, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Spécialisation (à venir)"; Visible: false; }

      Button #ClassTreeAttribuerButton { Anchor: (Right: 8, Top: 4, Width: 118, Height: 28); Style: @PlusButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 13, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Attribuer"; }
      }
      Button #ClassTreeResetButton { Anchor: (Right: 8, Bottom: 8, Width: 88, Height: 26); Style: @PlusButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Réinitialiser"; }
      }


      Group #ClassTreeEdgeRootStem { Anchor: (Left: 390, Top: 134, Width: 4, Height: 16); Background: @Divider; Visible: false; }
      Group #ClassTreeEdgeRootBranch { Anchor: (Left: 152, Top: 150, Width: 480, Height: 4); Background: @Divider; Visible: false; }
      Group #ClassTreeEdgeRootToNode6 { Anchor: (Left: 150, Top: 150, Width: 4, Height: 10); Background: @Divider; Visible: false; }
      Group #ClassTreeEdgeRootToNode7 { Anchor: (Left: 310, Top: 150, Width: 4, Height: 10); Background: @Divider; Visible: false; }
