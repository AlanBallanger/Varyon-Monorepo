          Group #ClassSidebarIconImage {
            Anchor: (Left: 4, Top: 4, Right: 4, Bottom: 4);
            ItemIcon #ClassSidebarItemIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
            Group #ClassSidebarCustomIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Left: 10);

