      Group #ClassTreeEdgeRootToNode2 { Anchor: (Left: 630, Top: 150, Width: 4, Height: 10); Background: @Divider; Visible: false; }
      Group #ClassTreeEdgeNode6ToNode9 { Anchor: (Left: 150, Top: 224, Width: 4, Height: 46); Background: @Divider; Visible: false; }
      Group #ClassTreeEdgeNode2ToNode8 { Anchor: (Left: 630, Top: 224, Width: 4, Height: 46); Background: @Divider; Visible: false; }

