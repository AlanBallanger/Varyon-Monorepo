          Label { FlexWeight: 1; Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Équipements magiques"; }
          Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center); Text: "0%"; }
