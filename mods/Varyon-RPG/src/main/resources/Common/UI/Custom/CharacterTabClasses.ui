        Group { Anchor: (Left: 0, Right: 0, Height: 26); LayoutMode: Left;
          ItemIcon { Anchor: (Width: 24, Height: 24); ItemId: "Weapon_Shortbow_Adamantite"; }
          Group { Anchor: (Width: 6); }
          Label { FlexWeight: 1; Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Armes de distance"; }
          Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center); Text: "0%"; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 26); LayoutMode: Left;
          ItemIcon { Anchor: (Width: 24, Height: 24); ItemId: "Weapon_Staff_Adamantite"; }
