$P = "CharacterPage.ui";

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Full;

  // ==================== COLONNE GAUCHE ====================
  Group {
    Anchor: (Left: 0, Top: 0, Bottom: 0, Width: 320);
    LayoutMode: Top;

    // --- Classe ---
    Group {
      Anchor: (Left: 0, Right: 0, Height: 24);
      LayoutMode: Left;
      Group { Anchor: (Width: 20, Height: 20); Background: PatchStyle(TexturePath: "Elements/Crown.png", Border: 0); }
      Group { Anchor: (Width: 6); }
      Label {
        Style: (FontSize: 21, TextColor: #C8A96E, RenderBold: true, HorizontalAlignment: Start, RenderUppercase: true);
        Text: "Classe";
      }
    }

    Group { Anchor: (Height: 8); }

    Group {
      Anchor: (Left: 0, Right: 0, Height: 210);
      LayoutMode: Full;
      Padding: (Full: 10);
      Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

      Group #ClassesNoClassCard {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Middle;
        Visible: false;

        Button #ClassesSelectClassButton {
          Anchor: (Width: 210, Height: 36);
          Style: $P.@PlusButtonStyle;
          LayoutMode: Left;
          Group { FlexWeight: 1; }
          Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Sélectionner une classe"; }
          Group { FlexWeight: 1; }
        }
      }

      Group #ClassesHasClassCard {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Full;
        Visible: true;

        Group {
          Anchor: (Left: 0, Top: 0, Width: 60, Height: 60);
          LayoutMode: Full;
          Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 6, Color: #31C677FF);
          Padding: (Full: 3);

          Group {
            LayoutMode: Middle;
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: #141820(0.82);

            ItemIcon #ClassesActiveClassIcon { Anchor: (Width: 48, Height: 48); }
          }
        }

        Label #ClassesActiveClassName {
          Anchor: (Left: 70, Right: 0, Top: 0, Height: 36);
          Style: (FontSize: 22, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, HorizontalAlignment: Start);
          Text: "Guerrier";
        }

        Group {
          Anchor: (Left: 70, Right: 0, Top: 36, Height: 22);
          LayoutMode: Left;

          Group {
            Background: #25793C(1.0);
            Padding: (Horizontal: 6, Vertical: 2);
            Label #ClassesActiveClassLevel {
              Style: (FontSize: 11, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center);
              Text: "NIVEAU 1";
            }
          }

          Group { Anchor: (Width: 8); }

          Label #ClassesActiveClassXp {
            Anchor: (Height: 22);
            Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center, HorizontalAlignment: Start);
            Text: "0 / 35 XP";
          }
        }

        Group {
          Anchor: (Left: 0, Right: 0, Top: 72, Height: 46);
          LayoutMode: Left;

          Group {
            Anchor: (Width: 40, Height: 40);
            LayoutMode: Full;
            Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 6);
            Padding: (Full: 3);
            Group {
              LayoutMode: Middle;
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Background: #141820(0.82);
              ItemIcon #ClassesActiveSpecIcon { Anchor: (Width: 32, Height: 32); }
            }
          }

          Group { Anchor: (Width: 8); }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #ClassesActiveSpecName {
              Anchor: (Left: 0, Right: 0, Height: 20);
              Style: (FontSize: 14, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, HorizontalAlignment: Start);
              Text: "Aucune";
            }

            Label #ClassesActiveSpecKeywords {
              Anchor: (Left: 0, Right: 0, Height: 14);
              Style: (FontSize: 11, TextColor: #6BCB7A, HorizontalAlignment: Start);
              Text: "";
            }
          }
        }

        Group {
          Anchor: (Left: 0, Right: 0, Top: 126, Bottom: 32);
          Background: PatchStyle(TexturePath: "Elements/Gauge.png", Border: 0);
          ProgressBar #ClassesActiveClassXpBar {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Value: 0.0;
            BarTexturePath: "Elements/Gauge_Fill.png";
          }
        }

        Group {
          Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 28);
          LayoutMode: Left;

          Button #ClassesChangeProfileButton {
            FlexWeight: 1;
            Style: $P.@PlusButtonStyle;
            LayoutMode: Left;
            Group { FlexWeight: 1; }
            Group { Anchor: (Width: 16, Height: 16); Background: PatchStyle(TexturePath: "Icons/Refresh.png", Border: 0); }
            Group { Anchor: (Width: 5); }
            Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Profils"; }
            Group { FlexWeight: 1; }
          }

          Group { Anchor: (Width: 4); }

          Button #ClassesViewTalentsButton {
            FlexWeight: 1;
            Style: $P.@PlusButtonStyle;
            LayoutMode: Left;
            Group { FlexWeight: 1; }
            Group { Anchor: (Width: 16, Height: 16); Background: PatchStyle(TexturePath: "Icons/Talent.png", Border: 0); }
            Group { Anchor: (Width: 5); }
            Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Voir talents"; }
            Group { FlexWeight: 1; }
          }
        }
      }
    }

    Group { FlexWeight: 1; }

    // --- Statistiques de classe ---
    Group {
      Anchor: (Left: 0, Right: 0, Height: 220);
      LayoutMode: Top;
      Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);
      Padding: (Full: 10);

      Group {
        Anchor: (Left: 0, Right: 0, Height: 20);
        LayoutMode: Left;
        Group { Anchor: (Width: 16, Height: 16); Background: PatchStyle(TexturePath: "Elements/Stats.png", Border: 0); }
        Group { Anchor: (Width: 6); }
        Label {
          Style: (FontSize: 13, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
          Text: "Statistiques de classe";
        }
      }

      Group { Anchor: (Height: 8); }

      Group {
        Anchor: (Left: 0, Right: 0, Height: 82);
        LayoutMode: Left;
        Group { FlexWeight: 1; LayoutMode: Top;
          Group { Anchor: (Left: 0, Right: 0, Height: 36); LayoutMode: Middle; Group { Anchor: (Width: 36, Height: 36); Background: PatchStyle(TexturePath: "Icons/health.png", Border: 0); } }
          Group { Anchor: (Height: 4); }
          Label #ClassesStatPv { Anchor: (Left: 0, Right: 0, Height: 24); Style: (FontSize: 20, TextColor: #FF6666, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "---"; }
          Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 11, TextColor: #C8BEB0, RenderUppercase: true, HorizontalAlignment: Center); Text: "Vie max"; }
        }
        Group { Anchor: (Width: 4, Top: 0, Bottom: 0); }
        Group { FlexWeight: 1; LayoutMode: Top;
          Group { Anchor: (Left: 0, Right: 0, Height: 36); LayoutMode: Middle; Group { Anchor: (Width: 36, Height: 36); Background: PatchStyle(TexturePath: "Icons/defense.png", Border: 0); } }
          Group { Anchor: (Height: 4); }
          Label #ClassesStatDef { Anchor: (Left: 0, Right: 0, Height: 24); Style: (FontSize: 20, TextColor: #66AAFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "---"; }
          Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 11, TextColor: #C8BEB0, RenderUppercase: true, HorizontalAlignment: Center); Text: "Red. degats"; }
        }
        Group { Anchor: (Width: 4, Top: 0, Bottom: 0); }
        Group { FlexWeight: 1; LayoutMode: Top;
          Group { Anchor: (Left: 0, Right: 0, Height: 36); LayoutMode: Middle; Group { Anchor: (Width: 36, Height: 36); Background: PatchStyle(TexturePath: "Icons/stamina.png", Border: 0); } }
          Group { Anchor: (Height: 4); }
          Label #ClassesStatEnd { Anchor: (Left: 0, Right: 0, Height: 24); Style: (FontSize: 20, TextColor: #66AAFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "---"; }
          Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 11, TextColor: #C8BEB0, RenderUppercase: true, HorizontalAlignment: Center); Text: "Endurance"; }
        }
      }

      Group { Anchor: (Height: 8); }

      Group {
        Anchor: (Left: 0, Right: 0, Height: 82);
        LayoutMode: Left;
        Group { FlexWeight: 1; LayoutMode: Top;
          Group { Anchor: (Left: 0, Right: 0, Height: 36); LayoutMode: Middle; Group { Anchor: (Width: 36, Height: 36); Background: PatchStyle(TexturePath: "Icons/attack.png", Border: 0); } }
          Group { Anchor: (Height: 4); }
          Label #ClassesStatAtk { Anchor: (Left: 0, Right: 0, Height: 24); Style: (FontSize: 20, TextColor: #FFD166, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "---"; }
          Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 11, TextColor: #C8BEB0, RenderUppercase: true, HorizontalAlignment: Center); Text: "Attaque"; }
        }
        Group { Anchor: (Width: 4, Top: 0, Bottom: 0); }
        Group { FlexWeight: 1; LayoutMode: Top;
          Group { Anchor: (Left: 0, Right: 0, Height: 36); LayoutMode: Middle; Group { Anchor: (Width: 36, Height: 36); Background: PatchStyle(TexturePath: "Icons/taux_crit.png", Border: 0); } }
          Group { Anchor: (Height: 4); }
          Label #ClassesStatCrit { Anchor: (Left: 0, Right: 0, Height: 24); Style: (FontSize: 20, TextColor: #FF8900, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "---"; }
          Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 11, TextColor: #C8BEB0, RenderUppercase: true, HorizontalAlignment: Center); Text: "Taux crit"; }
        }
        Group { Anchor: (Width: 4, Top: 0, Bottom: 0); }
        Group { FlexWeight: 1; LayoutMode: Top;
          Group { Anchor: (Left: 0, Right: 0, Height: 36); LayoutMode: Middle; Group { Anchor: (Width: 36, Height: 36); Background: PatchStyle(TexturePath: "Icons/degat_crit.png", Border: 0); } }
          Group { Anchor: (Height: 4); }
          Label #ClassesStatDcrit { Anchor: (Left: 0, Right: 0, Height: 24); Style: (FontSize: 20, TextColor: #FF8900, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "---"; }
          Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 11, TextColor: #C8BEB0, RenderUppercase: true, HorizontalAlignment: Center); Text: "Dgts crit"; }
        }
      }
    }
  }

  // ==================== SECTION DROITE ====================
  Group {
    Anchor: (Left: 332, Top: 0, Bottom: 0, Right: 0);
    LayoutMode: Top;

    // --- Titre section spécialisations ---
    Group {
      Anchor: (Left: 0, Right: 0, Height: 24);
      LayoutMode: Left;

      Group { Anchor: (Width: 20, Height: 20); Background: PatchStyle(TexturePath: "Elements/Star.png", Border: 0); }
      Group { Anchor: (Width: 8); }
      Label #ClassesSpecSectionTitle {
        Style: (FontSize: 21, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Start);
        Text: "Spécialisations du Guerrier";
      }
    }

    Group { Anchor: (Height: 8); }

    // --- 3 cartes spécialisations (horizontal) ---
    Group {
      FlexWeight: 1;
      Anchor: (Left: 0, Right: 0);
      LayoutMode: Left;

      // Spec 0
      Group #ClassesSpec0Card {
        FlexWeight: 1;
        LayoutMode: Full;
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

        Button #ClassesSpec0HoverButton {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Style: (
            Default: (Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10, Color: #FFFFFF(0.0))),
            Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
            Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10))
          );
        }

        Group {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Top;
          Padding: (Full: 14);

        Label #ClassesSpec0Name {
          Anchor: (Left: 0, Right: 0, Height: 20);
          Style: (FontSize: 15, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
          Text: "Rempart";
        }

        Group { Anchor: (Height: 4); }

        Group {
          Anchor: (Left: 0, Right: 0, Height: 72);
          LayoutMode: Middle;
          ItemIcon #ClassesSpec0Icon { Anchor: (Width: 64, Height: 64); }
        }

        Group { Anchor: (Height: 8); }

        Label #ClassesSpec0Keywords {
          Anchor: (Left: 0, Right: 0, Height: 16);
          Style: (FontSize: 12, TextColor: #6BCB7A, HorizontalAlignment: Center);
          Text: "";
        }

        Group { Anchor: (Height: 6); }
        Group { Anchor: (Left: 0, Right: 0, Height: 1); Background: #E8DCC8(0.16); }
        Group { Anchor: (Height: 6); }

        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/health.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "PV"; }
          Label #ClassesSpec0StatPv { Style: (FontSize: 12, TextColor: #FF6666, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/defense.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Red. degats"; }
          Label #ClassesSpec0StatDef { Style: (FontSize: 12, TextColor: #66AAFF, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/stamina.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Endurance"; }
          Label #ClassesSpec0StatEnd { Style: (FontSize: 12, TextColor: #66AAFF, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/attack.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Attaque"; }
          Label #ClassesSpec0StatAtk { Style: (FontSize: 12, TextColor: #FFD166, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/taux_crit.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Taux crit"; }
          Label #ClassesSpec0StatCrit { Style: (FontSize: 12, TextColor: #FF8900, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/degat_crit.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Dgts crit"; }
          Label #ClassesSpec0StatDcrit { Style: (FontSize: 12, TextColor: #FF8900, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }

        }

        Group #ClassesSpec0ConfirmPanel {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Middle;
          Background: #000000(0.72);
          Visible: false;

          Button #ClassesSpec0ConfirmButton {
            Anchor: (Width: 120, Height: 36);
            Style: (
              Default: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10)),
              Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
              Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10))
            );
            LayoutMode: Middle;
            Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Confirmer"; }
          }
        }
      }

      Group { Anchor: (Width: 8, Top: 0, Bottom: 0); }

      // Spec 1
      Group #ClassesSpec1Card {
        FlexWeight: 1;
        LayoutMode: Full;
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

        Button #ClassesSpec1HoverButton {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Style: (
            Default: (Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10, Color: #FFFFFF(0.0))),
            Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
            Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10))
          );
        }

        Group {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Top;
          Padding: (Full: 14);

        Label #ClassesSpec1Name {
          Anchor: (Left: 0, Right: 0, Height: 20);
          Style: (FontSize: 15, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
          Text: "Duelliste";
        }

        Group { Anchor: (Height: 4); }

        Group {
          Anchor: (Left: 0, Right: 0, Height: 72);
          LayoutMode: Middle;
          ItemIcon #ClassesSpec1Icon { Anchor: (Width: 64, Height: 64); }
        }

        Group { Anchor: (Height: 8); }

        Label #ClassesSpec1Keywords {
          Anchor: (Left: 0, Right: 0, Height: 16);
          Style: (FontSize: 12, TextColor: #6BCB7A, HorizontalAlignment: Center);
          Text: "";
        }

        Group { Anchor: (Height: 6); }
        Group { Anchor: (Left: 0, Right: 0, Height: 1); Background: #E8DCC8(0.16); }
        Group { Anchor: (Height: 6); }

        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/health.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "PV"; }
          Label #ClassesSpec1StatPv { Style: (FontSize: 12, TextColor: #FF6666, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/defense.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Red. degats"; }
          Label #ClassesSpec1StatDef { Style: (FontSize: 12, TextColor: #66AAFF, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/stamina.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Endurance"; }
          Label #ClassesSpec1StatEnd { Style: (FontSize: 12, TextColor: #66AAFF, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/attack.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Attaque"; }
          Label #ClassesSpec1StatAtk { Style: (FontSize: 12, TextColor: #FFD166, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/taux_crit.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Taux crit"; }
          Label #ClassesSpec1StatCrit { Style: (FontSize: 12, TextColor: #FF8900, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/degat_crit.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Dgts crit"; }
          Label #ClassesSpec1StatDcrit { Style: (FontSize: 12, TextColor: #FF8900, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }

        }

        Group #ClassesSpec1ConfirmPanel {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Middle;
          Background: #000000(0.72);
          Visible: false;

          Button #ClassesSpec1ConfirmButton {
            Anchor: (Width: 120, Height: 36);
            Style: (
              Default: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10)),
              Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
              Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10))
            );
            LayoutMode: Middle;
            Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Confirmer"; }
          }
        }
      }

      Group { Anchor: (Width: 8, Top: 0, Bottom: 0); }

      // Spec 2
      Group #ClassesSpec2Card {
        FlexWeight: 1;
        LayoutMode: Full;
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

        Button #ClassesSpec2HoverButton {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Style: (
            Default: (Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10, Color: #FFFFFF(0.0))),
            Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
            Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10))
          );
        }

        Group {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Top;
          Padding: (Full: 14);

        Label #ClassesSpec2Name {
          Anchor: (Left: 0, Right: 0, Height: 20);
          Style: (FontSize: 15, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center);
          Text: "Ombre";
        }

        Group { Anchor: (Height: 4); }

        Group {
          Anchor: (Left: 0, Right: 0, Height: 72);
          LayoutMode: Middle;
          ItemIcon #ClassesSpec2Icon { Anchor: (Width: 64, Height: 64); }
        }

        Group { Anchor: (Height: 8); }

        Label #ClassesSpec2Keywords {
          Anchor: (Left: 0, Right: 0, Height: 16);
          Style: (FontSize: 12, TextColor: #6BCB7A, HorizontalAlignment: Center);
          Text: "";
        }

        Group { Anchor: (Height: 6); }
        Group { Anchor: (Left: 0, Right: 0, Height: 1); Background: #E8DCC8(0.16); }
        Group { Anchor: (Height: 6); }

        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/health.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "PV"; }
          Label #ClassesSpec2StatPv { Style: (FontSize: 12, TextColor: #FF6666, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/defense.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Red. degats"; }
          Label #ClassesSpec2StatDef { Style: (FontSize: 12, TextColor: #66AAFF, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/stamina.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Endurance"; }
          Label #ClassesSpec2StatEnd { Style: (FontSize: 12, TextColor: #66AAFF, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/attack.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Attaque"; }
          Label #ClassesSpec2StatAtk { Style: (FontSize: 12, TextColor: #FFD166, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/taux_crit.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Taux crit"; }
          Label #ClassesSpec2StatCrit { Style: (FontSize: 12, TextColor: #FF8900, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
          Group { Anchor: (Width: 28, Height: 28); Background: PatchStyle(TexturePath: "Icons/degat_crit.png", Border: 0); }
          Group { Anchor: (Width: 5); }
          Label { FlexWeight: 1; Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Dgts crit"; }
          Label #ClassesSpec2StatDcrit { Style: (FontSize: 12, TextColor: #FF8900, RenderBold: true, VerticalAlignment: Center); Text: ""; }
        }

        }

        Group #ClassesSpec2ConfirmPanel {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          LayoutMode: Middle;
          Background: #000000(0.72);
          Visible: false;

          Button #ClassesSpec2ConfirmButton {
            Anchor: (Width: 120, Height: 36);
            Style: (
              Default: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10)),
              Hovered: (Background: PatchStyle(TexturePath: "Elements/HudPanelHovered.png", Border: 10)),
              Pressed: (Background: PatchStyle(TexturePath: "Elements/HudPanelActive.png", Border: 10))
            );
            LayoutMode: Middle;
            Label { Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Confirmer"; }
          }
        }
      }
    }

    Group { Anchor: (Height: 8); }

    // --- Bas : Compétences actives + Maîtrises d'armes ---
    Group {
      Anchor: (Left: 0, Right: 0, Height: 220);
      LayoutMode: Left;

      Group {
        FlexWeight: 1;
        LayoutMode: Full;
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);
        Padding: (Full: 10);

        Group {
          Anchor: (Left: 0, Top: 0, Right: 0, Height: 20);
          LayoutMode: Left;
          Group { Anchor: (Width: 16, Height: 16); Background: PatchStyle(TexturePath: "Icons/Talent.png", Border: 0); }
          Group { Anchor: (Width: 6); }
          Label {
            Style: (FontSize: 13, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            Text: "Compétences actives";
          }
        }

        Group {
          Anchor: (Left: 0, Top: 28, Bottom: 0, Right: 180);
          LayoutMode: Top;

          Group {
            Anchor: (Left: 0, Right: 0, Height: 82);
            LayoutMode: Left;
            Group { Anchor: (Width: 70); LayoutMode: Top; Background: #FFFFFF(0.05); Padding: (Full: 6);
              Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 10, TextColor: #C8BEB0, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); Text: "Sort 1"; }
              Label { Anchor: (Left: 0, Right: 0, Height: 12); Style: (FontSize: 10, TextColor: #A89E90, HorizontalAlignment: Center); Text: "E"; }
              Group { Anchor: (Left: 0, Right: 0, Height: 42); LayoutMode: Middle;
                Button #SkillSlotE { Anchor: (Width: 36, Height: 36); Style: (Default: (Background: #000000(0.0)), Hovered: (Background: #FFFFFF(0.08)), Pressed: (Background: #FFFFFF(0.12))); LayoutMode: Full;
                  Group #SkillSlotEBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0); }
                  ItemIcon #SkillSlotEIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
                }
              }
            }
            Group { Anchor: (Width: 4); }
            Group { Anchor: (Width: 70); LayoutMode: Top; Background: #FFFFFF(0.05); Padding: (Full: 6);
              Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 10, TextColor: #C8BEB0, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); Text: "Sort 2"; }
              Label { Anchor: (Left: 0, Right: 0, Height: 12); Style: (FontSize: 10, TextColor: #A89E90, HorizontalAlignment: Center); Text: "R"; }
              Group { Anchor: (Left: 0, Right: 0, Height: 42); LayoutMode: Middle;
                Button #SkillSlotR { Anchor: (Width: 36, Height: 36); Style: (Default: (Background: #000000(0.0)), Hovered: (Background: #FFFFFF(0.08)), Pressed: (Background: #FFFFFF(0.12))); LayoutMode: Full;
                  Group #SkillSlotRBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0); }
                  ItemIcon #SkillSlotRIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
                }
              }
            }
            Group { Anchor: (Width: 4); }
            Group { Anchor: (Width: 70); LayoutMode: Top; Background: #FFFFFF(0.05); Padding: (Full: 6);
              Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 10, TextColor: #C8BEB0, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); Text: "Sort 6"; }
              Label { Anchor: (Left: 0, Right: 0, Height: 12); Style: (FontSize: 10, TextColor: #A89E90, HorizontalAlignment: Center); Text: "A"; }
              Group { Anchor: (Left: 0, Right: 0, Height: 42); LayoutMode: Middle;
                Button #SkillSlotA { Anchor: (Width: 36, Height: 36); Style: (Default: (Background: #000000(0.0)), Hovered: (Background: #FFFFFF(0.08)), Pressed: (Background: #FFFFFF(0.12))); LayoutMode: Full;
                  Group #SkillSlotABg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0); }
                  ItemIcon #SkillSlotAIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
                }
              }
            }
          }

          Group { Anchor: (Height: 6); }

          Group {
            Anchor: (Left: 0, Right: 0, Height: 82);
            LayoutMode: Left;
            Group { Anchor: (Width: 70); LayoutMode: Top; Background: #FFFFFF(0.05); Padding: (Full: 6);
              Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 10, TextColor: #C8BEB0, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); Text: "Sort 3"; }
              Label { Anchor: (Left: 0, Right: 0, Height: 12); Style: (FontSize: 10, TextColor: #A89E90, HorizontalAlignment: Center); Text: "Crouch+A"; }
              Group { Anchor: (Left: 0, Right: 0, Height: 42); LayoutMode: Middle;
                Button #SkillSlotCrouchA { Anchor: (Width: 36, Height: 36); Style: (Default: (Background: #000000(0.0)), Hovered: (Background: #FFFFFF(0.08)), Pressed: (Background: #FFFFFF(0.12))); LayoutMode: Full;
                  Group #SkillSlotCrouchABg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0); }
                  ItemIcon #SkillSlotCrouchAIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
                }
              }
            }
            Group { Anchor: (Width: 4); }
            Group { Anchor: (Width: 70); LayoutMode: Top; Background: #FFFFFF(0.05); Padding: (Full: 6);
              Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 10, TextColor: #C8BEB0, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); Text: "Sort 4"; }
              Label { Anchor: (Left: 0, Right: 0, Height: 12); Style: (FontSize: 10, TextColor: #A89E90, HorizontalAlignment: Center); Text: "Crouch+E"; }
              Group { Anchor: (Left: 0, Right: 0, Height: 42); LayoutMode: Middle;
                Button #SkillSlotCrouchE { Anchor: (Width: 36, Height: 36); Style: (Default: (Background: #000000(0.0)), Hovered: (Background: #FFFFFF(0.08)), Pressed: (Background: #FFFFFF(0.12))); LayoutMode: Full;
                  Group #SkillSlotCrouchEBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0); }
                  ItemIcon #SkillSlotCrouchEIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
                }
              }
            }
            Group { Anchor: (Width: 4); }
            Group { Anchor: (Width: 70); LayoutMode: Top; Background: #FFFFFF(0.05); Padding: (Full: 6);
              Label { Anchor: (Left: 0, Right: 0, Height: 14); Style: (FontSize: 10, TextColor: #C8BEB0, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center); Text: "Sort 5"; }
              Label { Anchor: (Left: 0, Right: 0, Height: 12); Style: (FontSize: 10, TextColor: #A89E90, HorizontalAlignment: Center); Text: "Crouch+R"; }
              Group { Anchor: (Left: 0, Right: 0, Height: 42); LayoutMode: Middle;
                Button #SkillSlotCrouchR { Anchor: (Width: 36, Height: 36); Style: (Default: (Background: #000000(0.0)), Hovered: (Background: #FFFFFF(0.08)), Pressed: (Background: #FFFFFF(0.12))); LayoutMode: Full;
                  Group #SkillSlotCrouchRBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Background: PatchStyle(TexturePath: "Elements/Add_Skill.png", Border: 0); }
                  ItemIcon #SkillSlotCrouchRIcon { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
                }
              }
            }
          }
        }

        Group {
          Anchor: (Right: 0, Top: 0, Bottom: 0, Width: 240);
          LayoutMode: Top;

          Label #ClassesSkillPickerLabel {
            Anchor: (Left: 0, Right: 0, Height: 16);
            Style: (FontSize: 13, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true);
            Text: "Compétences disponibles";
          }
          Group { Anchor: (Height: 4); }
          Group #ClassesSkillPickerList {
            Anchor: (Left: 0, Right: 0);
            LayoutMode: Top;
          }
        }
      }

      Group { Anchor: (Width: 8, Top: 0, Bottom: 0); }

      Group {
        Anchor: (Width: 240, Top: 0, Bottom: 0);
        LayoutMode: Top;
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);
        Padding: (Full: 10);

        Group {
          Anchor: (Left: 0, Right: 0, Height: 20);
          LayoutMode: Left;
          Group { Anchor: (Width: 16, Height: 16); Background: PatchStyle(TexturePath: "Elements/Mastery.png", Border: 0); }
          Group { Anchor: (Width: 6); }
          Label {
            Style: (FontSize: 13, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            Text: "Maîtrises d'armes";
          }
        }

        Group { Anchor: (Height: 6); }

        Group { Anchor: (Left: 0, Right: 0, Height: 26); LayoutMode: Left;
          ItemIcon { Anchor: (Width: 24, Height: 24); ItemId: "Weapon_Sword_Adamantite"; }
          Group { Anchor: (Width: 6); }
          Label { FlexWeight: 1; Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Épée à une main"; }
          Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center); Text: "0%"; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 26); LayoutMode: Left;
          ItemIcon { Anchor: (Width: 24, Height: 24); ItemId: "Weapon_Daggers_Adamantite"; }
          Group { Anchor: (Width: 6); }
          Label { FlexWeight: 1; Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Dagues"; }
          Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center); Text: "0%"; }
        }
        Group { Anchor: (Height: 2); }
        Group { Anchor: (Left: 0, Right: 0, Height: 26); LayoutMode: Left;
          ItemIcon { Anchor: (Width: 24, Height: 24); ItemId: "Weapon_Axe_Adamantite"; }
          Group { Anchor: (Width: 6); }
          Label { FlexWeight: 1; Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center); Text: "Hache à une main"; }
          Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center); Text: "0%"; }
        }
        Group { Anchor: (Height: 2); }
