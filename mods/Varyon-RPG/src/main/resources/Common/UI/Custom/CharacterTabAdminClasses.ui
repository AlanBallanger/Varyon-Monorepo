$C = "Common.ui";

@AdminButtonStyle = (
  Default: (Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)),
  Hovered: (Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)),
  Pressed: (Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)),
  Disabled: (Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)),
  Sounds: $C.@ButtonSounds
);

@AdminDestructiveButtonStyle = (
  Default: (Background: PatchStyle(TexturePath: "Common/Buttons/Destructive.png", Border: 8)),
  Hovered: (Background: PatchStyle(TexturePath: "Common/Buttons/Destructive_Hovered.png", Border: 8)),
  Pressed: (Background: PatchStyle(TexturePath: "Common/Buttons/Destructive_Pressed.png", Border: 8)),
  Disabled: (Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)),
  Sounds: $C.@ButtonSounds
);

@AdminLabelStyle = (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center);
@AdminSectionTitleStyle = (FontSize: 13, TextColor: #C8A96E, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
@AdminValueStyle = (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center);

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Left;

  Group {
    Anchor: (Width: 520);
    LayoutMode: Top;
    Padding: (Full: 12);
    Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

    Group {
      Anchor: (Left: 0, Right: 0, Height: 28);
      LayoutMode: Left;

      Label { Anchor: (Height: 28); Style: @AdminSectionTitleStyle; Text: "Classe :"; }
      Group { Anchor: (Width: 10); }

      Button #AdminClassPrev {
        Anchor: (Width: 28, Height: 26); Style: @AdminButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "<"; }
      }
      Group { Anchor: (Width: 8); }
      Label #AdminClassName {
        Anchor: (Width: 220, Height: 28);
        Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        Text: "—";
      }
      Group { Anchor: (Width: 8); }
      Button #AdminClassNext {
        Anchor: (Width: 28, Height: 26); Style: @AdminButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ">"; }
      }

      Group { Anchor: (Width: 16); }
      Label { Anchor: (Height: 28); Style: @AdminLabelStyle; Text: "Niveau :"; }
      Group { Anchor: (Width: 6); }
      Label #AdminClassLevel { Anchor: (Height: 28); Style: @AdminValueStyle; Text: "—"; }
      Group { Anchor: (Width: 12); }
      Label { Anchor: (Height: 28); Style: @AdminLabelStyle; Text: "XP :"; }
      Group { Anchor: (Width: 6); }
      Label #AdminClassXp { Anchor: (Height: 28); Style: @AdminValueStyle; Text: "—"; }
    }

    Group { Anchor: (Height: 10); }
    Label { Anchor: (Left: 0, Right: 0, Height: 18); Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center); Text: "Ajouter XP"; }
    Group { Anchor: (Height: 4); }
    Group {
      Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
      Button #AdminClassXp100 { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+100"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassXp1k { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+1K"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassXp5k { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+5K"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassXp10k { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+10K"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassXp50k { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+50K"; } }
    }

    Group { Anchor: (Height: 10); }
    Label { Anchor: (Left: 0, Right: 0, Height: 18); Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center); Text: "Niveau"; }
    Group { Anchor: (Height: 4); }
    Group {
      Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
      Button #AdminClassLvlMinus5 { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "-5"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassLvlMinus1 { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "-1"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassLvlPlus1 { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+1"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassLvlPlus5 { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+5"; } }
      Group { Anchor: (Width: 6); }
      Button #AdminClassLvlMax { Anchor: (Width: 68, Height: 30); Style: @AdminButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #D4AF37, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "MAX"; } }
    }

    Group { Anchor: (Height: 10); }
    Label { Anchor: (Left: 0, Right: 0, Height: 18); Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center); Text: "Actions"; }
    Group { Anchor: (Height: 4); }
    Group {
      Anchor: (Left: 0, Right: 0, Height: 30); LayoutMode: Left;
      Button #AdminClassResetTalents { Anchor: (Width: 160, Height: 30); Style: @AdminDestructiveButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Reset talents (classe)"; } }
      Group { Anchor: (Width: 10); }
      Button #AdminClassResetAll { Anchor: (Width: 160, Height: 30); Style: @AdminDestructiveButtonStyle; LayoutMode: Middle; Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Reset complet"; } }
    }

    Group { Anchor: (Height: 12); }
    Label #AdminClassFeedback { Anchor: (Left: 0, Right: 0, Height: 20); Style: (FontSize: 12, TextColor: #6BCB7A, HorizontalAlignment: Start, VerticalAlignment: Center); Text: ""; Visible: false; }
  }

  Group { Anchor: (Width: 16); }

  Group {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Full: 12);
    Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

    Label { Anchor: (Left: 0, Right: 0, Height: 18); Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center); Text: "Stats joueur"; }
    Group { Anchor: (Height: 8); }
    Group #AdminClassStatsContainer { Anchor: (Left: 0, Right: 0); LayoutMode: Top; }
  }
}
