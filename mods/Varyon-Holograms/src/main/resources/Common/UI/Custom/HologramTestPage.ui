$C = "Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 180);

    #Title {
      Label {
        Text: "TEST UI HOLO";
        Style: (FontSize: 15, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    #Content {
      Padding: (Top: 8, Bottom: 8, Left: 10, Right: 10);
      LayoutMode: Top;

      Label {
        Anchor: (Height: 40, Bottom: 12);
        Text: "Si tu vois ce texte, le Custom UI du mod fonctionne.";
        Style: (FontSize: 14, TextColor: #c8d6e0, HorizontalAlignment: Center, Wrap: true);
      }

      Button #TestCloseButton {
        Anchor: (Left: 0, Right: 0, Height: 44);
        Style: ButtonStyle(
          Default: (Background: (Color: #185a28)),
          Hovered: (Background: (Color: #286a38)),
          Pressed: (Background: (Color: #0f4018))
        );
        Group {
          LayoutMode: Middle;
          Label {
            Text: "FERMER";
            Style: (FontSize: 13, RenderBold: true, TextColor: #aaffaa, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }
    }
  }
}
