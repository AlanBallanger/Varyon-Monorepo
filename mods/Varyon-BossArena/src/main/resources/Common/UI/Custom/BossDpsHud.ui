  Group #WaveHudPanel {
    Visible: false;
    Anchor: (Top: 57, Left: 12, Width: 250, Height: 149);
    Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10, Color: #FFFFFF(0.82));
    LayoutMode: Full;

    Group #WaveHudBorder {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      LayoutMode: Full;

      Group #WaveCornerTL {
        Anchor: (Left: 2, Top: 2, Width: 14, Height: 14);
        Background: PatchStyle(TexturePath: "Elements/Decorated_Border.png", Border: 0);
      }
      Group #WaveCornerTR {
        Anchor: (Right: 2, Top: 2, Width: 14, Height: 14);
        Background: PatchStyle(TexturePath: "Elements/Decorated_Border_TR.png", Border: 0);
      }
      Group #WaveCornerBL {
        Anchor: (Left: 2, Bottom: 2, Width: 14, Height: 14);
        Background: PatchStyle(TexturePath: "Elements/Decorated_Border_BL.png", Border: 0);
      }
      Group #WaveCornerBR {
        Anchor: (Right: 2, Bottom: 2, Width: 14, Height: 14);
        Background: PatchStyle(TexturePath: "Elements/Decorated_Border_BR.png", Border: 0);
      }
    }

    Group #WaveHudContent {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      LayoutMode: Top;
      Padding: (Horizontal: 10, Vertical: 8);

      Label #WaveNumberText {
        Anchor: (Height: 20);
        Text: " ";
        Style: (FontSize: 16, TextColor: #E8C84A, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Group { Anchor: (Height: 6); }

      Label #WaveMobsRemainingText {
        Anchor: (Height: 17);
        Text: " ";
        Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Group { Anchor: (Height: 8); }

      Group #WaveSeparator {
        Anchor: (Left: 0, Right: 0, Height: 1);
        Background: #FFFFFF(0.25);
      }

      Group { Anchor: (Height: 8); }

      Label #WaveTotalKilledText {
        Anchor: (Height: 17);
        Text: " ";
        Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: false, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Group { Anchor: (Height: 6); }

      Label #WavePersonalKillsText {
        Anchor: (Height: 17);
        Text: " ";
        Style: (FontSize: 13, TextColor: #F5D547, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
