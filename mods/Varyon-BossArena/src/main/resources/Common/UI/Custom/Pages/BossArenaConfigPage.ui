  Group #PlanificationPanel {
    Anchor: (Left: 360, Top: 296, Width: 1200, Height: 690);
    Visible: false;

      Label #BossTimedTitle {
        Anchor: (Left: 32, Top: 28, Width: 520, Height: 28);
        Text: "Planification";
        Style: (FontSize: 24, TextColor: #f3f7ff, RenderBold: true);
      }

      TextButton #TimedTextsButton {
        Anchor: (Left: 1020, Top: 24, Width: 120, Height: 36);
        Text: "Textes";
        Style: TextButtonStyle(
          Default: (Background: #2a4a6b, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #35608a, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #1e3855, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Sounds: $C.@ButtonSounds);
      }

      TextButton #TimedAddButton {
        Anchor: (Left: 1150, Top: 24, Width: 40, Height: 36);
