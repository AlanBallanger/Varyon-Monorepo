$C = "../Common.ui";

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);

  Panel #Overlay {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    Background: #000000(0.45);
  }

  Group #Center {
    LayoutMode: Middle;
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);

  Group #Window {
    Anchor: (Width: 1920, Height: 1080);

  Panel #Background {
    Anchor: (Left: 330, Top: 88, Width: 1260, Height: 904);
    Background: #0f1725;
  }

  Panel #AccentLeft {
    Anchor: (Left: 330, Top: 88, Width: 4, Height: 904);
    Background: #4f79ab;
  }

  Panel #HeaderPanel {
    Anchor: (Left: 334, Top: 88, Width: 1256, Height: 104);
    Background: #152238;
  }

  Label #TitleLabel {
    Anchor: (Left: 368, Top: 108, Width: 860, Height: 42);
    Text: "Config BossArena";
    Style: (FontSize: 31, TextColor: #f3f7ff, RenderBold: true);
  }

  Label #SubtitleLabel {
    Anchor: (Left: 368, Top: 150, Width: 880, Height: 26);
    Text: "Configurer boss, marchands et arènes";
    Style: (FontSize: 15, TextColor: #b2c0d2);
  }

  TextButton #CloseButton {
    Anchor: (Left: 1428, Top: 116, Width: 136, Height: 48);
    Text: "Fermer";
    Style: TextButtonStyle(
      Default: (Background: #2a3d58, LabelStyle: (FontSize: 14, TextColor: #e6eefc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Hovered: (Background: #38567b, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Pressed: (Background: #4d77a8, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Disabled: (Background: #253244, LabelStyle: (FontSize: 14, TextColor: #8ea1bb, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Sounds: $C.@ButtonSounds
    );
  }

  Panel #TabPanel {
    Anchor: (Left: 360, Top: 214, Width: 1200, Height: 60);
    Background: #182a44;
  }

  Panel #TabIndicatorBosses {
    Anchor: (Left: 369, Top: 220, Width: 294, Height: 48);
    Background: #8fb7ff;
    Visible: false;
  }

  Panel #TabIndicatorArenas {
    Anchor: (Left: 666, Top: 220, Width: 294, Height: 48);
    Background: #8fb7ff;
    Visible: false;
  }

  Panel #TabIndicatorPlanification {
    Anchor: (Left: 963, Top: 220, Width: 294, Height: 48);
    Background: #8fb7ff;
    Visible: false;
  }

  Panel #TabIndicatorShop {
    Anchor: (Left: 1260, Top: 220, Width: 294, Height: 48);
    Background: #8fb7ff;
    Visible: false;
  }

  TextButton #BossesTab {
    Anchor: (Left: 372, Top: 223, Width: 288, Height: 42);
    Text: "Boss";
    Style: TextButtonStyle(
      Default: (Background: #2b4568, LabelStyle: (FontSize: 14, TextColor: #d8e3f4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Hovered: (Background: #3f6391, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Pressed: (Background: #4f79ab, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Sounds: $C.@ButtonSounds
    );
  }

  TextButton #ArenasTab {
    Anchor: (Left: 669, Top: 223, Width: 288, Height: 42);
    Text: "Arènes";
    Style: TextButtonStyle(
      Default: (Background: #2b4568, LabelStyle: (FontSize: 14, TextColor: #d8e3f4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Hovered: (Background: #3f6391, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Pressed: (Background: #4f79ab, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Sounds: $C.@ButtonSounds
    );
  }

  TextButton #PlanificationTab {
    Anchor: (Left: 966, Top: 223, Width: 288, Height: 42);
    Text: "Planification";
    Style: TextButtonStyle(
      Default: (Background: #2b4568, LabelStyle: (FontSize: 14, TextColor: #d8e3f4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Hovered: (Background: #3f6391, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Pressed: (Background: #4f79ab, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Sounds: $C.@ButtonSounds
    );
  }

  TextButton #ShopTab {
    Anchor: (Left: 1263, Top: 223, Width: 288, Height: 42);
    Text: "Marchands";
    Style: TextButtonStyle(
      Default: (Background: #2b4568, LabelStyle: (FontSize: 14, TextColor: #d8e3f4, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Hovered: (Background: #3f6391, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Pressed: (Background: #4f79ab, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
      Sounds: $C.@ButtonSounds
    );
  }

  Panel #ContentPanel {
    Anchor: (Left: 360, Top: 296, Width: 1200, Height: 660);
    Background: #172639;
  }

  Group #BossesPanel {
    Anchor: (Left: 360, Top: 296, Width: 1200, Height: 660);
    Visible: false;

    Label #BossTitleLabel {
      Anchor: (Left: 32, Top: 28, Width: 800, Height: 30);
      Text: "Boss";
      Style: (FontSize: 24, TextColor: #f3f7ff, RenderBold: true);
    }

    TextButton #BossAddButton {
      Anchor: (Left: 1040, Top: 24, Width: 150, Height: 36);
      Text: "Ajouter un boss";
      Style: TextButtonStyle(
        Default: (Background: #1f7d4b, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Hovered: (Background: #2b9a5f, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Pressed: (Background: #17633c, LabelStyle: (FontSize: 16, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
        Sounds: $C.@ButtonSounds
      );
    }

    Label #BossHeaderName {
      Anchor: (Left: 44, Top: 68, Width: 420, Height: 24);
      Text: "BossID";
      Style: (FontSize: 14, TextColor: #8ea1bb, RenderBold: true);
    }

    Label #BossHeaderNpc {
      Anchor: (Left: 484, Top: 68, Width: 220, Height: 24);
      Text: "ID PNJ";
      Style: (FontSize: 14, TextColor: #8ea1bb, RenderBold: true);
    }

    Label #BossHeaderAmount {
      Anchor: (Left: 724, Top: 68, Width: 80, Height: 24);
      Text: "Qté";
      Style: (FontSize: 14, TextColor: #8ea1bb, RenderBold: true);
    }

    Label #BossHeaderEdit {
      Anchor: (Left: 892, Top: 68, Width: 110, Height: 24);
      Text: "Éditer";
      Style: (FontSize: 14, TextColor: #8ea1bb, RenderBold: true);
    }

    Label #BossHeaderDelete {
      Anchor: (Left: 1030, Top: 68, Width: 110, Height: 24);
      Text: "Suppr";
      Style: (FontSize: 14, TextColor: #8ea1bb, RenderBold: true);
    }

    TextButton #BossScrollUp {
      Anchor: (Left: 1168, Top: 96, Width: 22, Height: 22);
      Text: "^";
      Visible: false;
      Style: TextButtonStyle(
        Default: (Background: #2a3d58, LabelStyle: (FontSize: 12, TextColor: #e6eefc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
