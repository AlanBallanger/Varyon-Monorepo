    Label #BossStatusLabel {
      Anchor: (Left: 32, Top: 610, Width: 1136, Height: 30);
      Text: "";
      Style: (FontSize: 14, TextColor: #b2c0d2);
    }

    Group #BossEditorOverlay {
      Anchor: (Left: 0, Top: 0, Width: 1200, Height: 660);
      Visible: false;

      Panel #BossEditorBackdrop {
        Anchor: (Left: 0, Top: 0, Width: 1200, Height: 660);
        Background: #05090f(0.75);
      }

      Panel #BossEditorWindow {
        Anchor: (Left: 90, Top: 56, Width: 1020, Height: 548);
        Background: #0f1725;
      }

      Label #BossEditorTitle {
        Anchor: (Left: 118, Top: 78, Width: 760, Height: 30);
        Text: "Édition de boss";
        Style: (FontSize: 22, TextColor: #f3f7ff, RenderBold: true);
      }

      TextButton #BossEditorCloseButton {
        Anchor: (Left: 964, Top: 78, Width: 120, Height: 34);
        Text: "Fermer";
        Style: TextButtonStyle(
          Default: (Background: #2a3d58, LabelStyle: (FontSize: 13, TextColor: #e6eefc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #38567b, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #4d77a8, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Sounds: $C.@ButtonSounds
        );
      }

      Label #BossEditNameLabel { Anchor: (Left: 118, Top: 118, Width: 120, Height: 20); Text: "BossID"; Style: (FontSize: 13, TextColor: #8ea1bb, RenderBold: true); }
      TextField #BossEditName { Anchor: (Left: 118, Top: 140, Width: 120, Height: 28); Value: ""; Style: (FontSize: 13, TextColor: #e6eefc); Padding: (Left: 8); Background: #122036; }
      Label #BossEditNpcIdLabel { Anchor: (Left: 248, Top: 118, Width: 220, Height: 20); Text: "ID PNJ (recherche)"; Style: (FontSize: 13, TextColor: #8ea1bb, RenderBold: true); }
      TextField #BossEditNpcId { Anchor: (Left: 248, Top: 140, Width: 220, Height: 28); Value: ""; Style: (FontSize: 13, TextColor: #e6eefc); Padding: (Left: 8); Background: #122036; }
      Label #BossEditTierLabel { Anchor: (Left: 478, Top: 118, Width: 120, Height: 20); Text: "Rang"; Style: (FontSize: 13, TextColor: #8ea1bb, RenderBold: true); }
      DropdownBox #BossEditTier {
        Anchor: (Left: 478, Top: 140, Width: 120, Height: 28);
        Style: $C.@DefaultDropdownBoxStyle;
        Value: "common";
        DropdownEntry { Value: "common"; Text: "Commun"; }
        DropdownEntry { Value: "uncommon"; Text: "Peu commun"; }
        DropdownEntry { Value: "rare"; Text: "Rare"; }
        DropdownEntry { Value: "epic"; Text: "Épique"; }
        DropdownEntry { Value: "legendary"; Text: "Légendaire"; }
      }
