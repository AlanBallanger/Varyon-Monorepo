        Style: (FontSize: 12, TextColor: #8ea1bb);
      }

      Label #TimedAnnounceTextLabel { Anchor: (Left: 172, Top: 232, Width: 280, Height: 20); Text: "Texte d'annonce"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      TextField #TimedAnnounceText { Anchor: (Left: 172, Top: 256, Width: 856, Height: 30); Value: ""; Style: (FontSize: 12, TextColor: #e6eefc); Padding: (Left: 8); Background: #122036; }

      Label #TimedReminderTextLabel { Anchor: (Left: 172, Top: 296, Width: 320, Height: 20); Text: "Texte de rappel 5 min"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      TextField #TimedReminderText { Anchor: (Left: 172, Top: 320, Width: 856, Height: 30); Value: ""; Style: (FontSize: 12, TextColor: #e6eefc); Padding: (Left: 8); Background: #122036; }

      Label #TimedGraceTextLabel { Anchor: (Left: 172, Top: 360, Width: 320, Height: 20); Text: "Texte grace ($time mm:ss)"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      TextField #TimedGraceText { Anchor: (Left: 172, Top: 384, Width: 856, Height: 30); Value: ""; Style: (FontSize: 12, TextColor: #e6eefc); Padding: (Left: 8); Background: #122036; }

      TextButton #TimedTextsClose {
        Anchor: (Left: 892, Top: 430, Width: 136, Height: 36);
        Text: "Fermer";
        Style: TextButtonStyle(
          Default: (Background: #2a3b52, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #35506e, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #1e2b3c, LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
