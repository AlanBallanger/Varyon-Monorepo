  Group #PlanificationPanel {
    Anchor: (Left: 360, Top: 296, Width: 1200, Height: 660);
    Visible: false;

      Label #BossTimedTitle {
        Anchor: (Left: 32, Top: 28, Width: 520, Height: 28);
        Text: "Planification";
        Style: (FontSize: 24, TextColor: #f3f7ff, RenderBold: true);
      }

      TextButton #TimedAddButton {
        Anchor: (Left: 1150, Top: 24, Width: 40, Height: 36);
        Text: "+";
        Style: TextButtonStyle(
          Default: (Background: #1f7d4b, LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #2b9a5f, LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #17633c, LabelStyle: (FontSize: 20, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
        );
      }

      Label #BossTimedHint1 { Anchor: (Left: 32, Top: 64, Width: 1100, Height: 16); Text: "Temps réapparition : délai h/min/s. Planifié : intervalle h/j/s + arrivée + disparition. Manuel : pas d'auto-planning, Apparition = forcé."; Style: (FontSize: 12, TextColor: #8ea1bb); }

      Label #BossTimedHeaderEnabled { Anchor: (Left: 40, Top: 90, Width: 48, Height: 20); Text: "Actif"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossTimedHeaderMode { Anchor: (Left: 94, Top: 90, Width: 100, Height: 20); Text: "Mode"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossTimedHeaderBossId { Anchor: (Left: 200, Top: 90, Width: 200, Height: 20); Text: "Boss"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossTimedHeaderArenaId { Anchor: (Left: 408, Top: 90, Width: 130, Height: 20); Text: "Arène"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossTimedHeaderMinPlayers { Anchor: (Left: 544, Top: 90, Width: 40, Height: 20); Text: "Joueurs"; Style: (FontSize: 11, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossTimedHeaderRequire { Anchor: (Left: 590, Top: 90, Width: 70, Height: 20); Text: "Près arène"; Style: (FontSize: 11, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossTimedHeaderDespawnH { Anchor: (Left: 40, Top: 1, Width: 1, Height: 1); Text: ""; Visible: false; Style: (FontSize: 1, TextColor: #8ea1bb); }
      Label #BossTimedHeaderDespawnM { Anchor: (Left: 40, Top: 1, Width: 1, Height: 1); Text: ""; Visible: false; Style: (FontSize: 1, TextColor: #8ea1bb); }
      Label #BossTimedHeaderAnnounceGlobal { Anchor: (Left: 666, Top: 90, Width: 70, Height: 20); Text: "Ann Glob"; Style: (FontSize: 10, TextColor: #8ea1bb, RenderBold: true); }
