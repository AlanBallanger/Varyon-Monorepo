        TextButton #ArenaDelete32 { Anchor: (Left: 884, Top: 8, Width: 48, Height: 30); Text: "-"; Style: TextButtonStyle(Default: (Background: #4a1f32, LabelStyle: (FontSize: 17, TextColor: #ffe3ec, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Hovered: (Background: #663048, LabelStyle: (FontSize: 17, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Pressed: (Background: #7f3d5a, LabelStyle: (FontSize: 17, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)), Sounds: $C.@ButtonSounds); }
