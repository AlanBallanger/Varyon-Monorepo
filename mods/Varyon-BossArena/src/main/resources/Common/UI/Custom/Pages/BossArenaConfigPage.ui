    Label #BossEmptyLabel {
      Anchor: (Left: 32, Top: 124, Width: 1136, Height: 30);
      Text: "";
      Visible: false;
      Style: (FontSize: 16, TextColor: #b2c0d2);
    }

    Label #BossOverflowLabel {
      Anchor: (Left: 32, Top: 546, Width: 950, Height: 26);
      Text: "";
      Visible: false;
      Style: (FontSize: 14, TextColor: #ffd88f);
    }

    Label #BossScrollPageLabel {
