      }

      Panel #BossPoolWindow {
        Anchor: (Left: 220, Top: 60, Width: 760, Height: 540);
        Background: #0f1725;
      }

      Label #BossPoolTitle {
        Anchor: (Left: 248, Top: 84, Width: 520, Height: 30);
        Text: "Pool de boss";
        Style: (FontSize: 22, TextColor: #f3f7ff, RenderBold: true);
      }

      Label #BossPoolHint {
        Anchor: (Left: 248, Top: 118, Width: 700, Height: 18);
        Text: "ON = dans le pool. Ajouter via la liste, ou creez des boss dans l'onglet Bosses.";
        Style: (FontSize: 12, TextColor: #8ea1bb);
      }

      TextButton #BossPoolCloseButton {
        Anchor: (Left: 820, Top: 84, Width: 120, Height: 34);
        Text: "Fermer";
        Style: TextButtonStyle(
          Default: (Background: #2a3d58, LabelStyle: (FontSize: 13, TextColor: #e6eefc, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #38567b, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #4d77a8, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Sounds: $C.@ButtonSounds
        );
      }

      TextButton #BossPoolApplyButton {
        Anchor: (Left: 680, Top: 84, Width: 120, Height: 34);
        Text: "Appliquer";
        Style: TextButtonStyle(
          Default: (Background: #1f7d4b, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #2b9a5f, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #17633c, LabelStyle: (FontSize: 13, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Sounds: $C.@ButtonSounds
        );
      }

      DropdownBox #BossPoolPick {
        Anchor: (Left: 248, Top: 142, Width: 420, Height: 28);
        Style: $C.@DefaultDropdownBoxStyle;
        Value: "";
        DropdownEntry { Value: ""; Text: "(choisir un boss)"; }
      }
      TextButton #BossPoolAddButton {
        Anchor: (Left: 680, Top: 142, Width: 120, Height: 28);
        Text: "Ajouter";
        Style: TextButtonStyle(
          Default: (Background: #1f7d4b, LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Hovered: (Background: #2b9a5f, LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Pressed: (Background: #17633c, LabelStyle: (FontSize: 12, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
          Sounds: $C.@ButtonSounds
        );
      }

      Label #BossPoolHeaderName { Anchor: (Left: 248, Top: 178, Width: 320, Height: 20); Text: "Boss"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossPoolHeaderOn { Anchor: (Left: 578, Top: 178, Width: 60, Height: 20); Text: "Actif"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }
      Label #BossPoolHeaderWeight { Anchor: (Left: 658, Top: 178, Width: 120, Height: 20); Text: "Poids"; Style: (FontSize: 12, TextColor: #8ea1bb, RenderBold: true); }

