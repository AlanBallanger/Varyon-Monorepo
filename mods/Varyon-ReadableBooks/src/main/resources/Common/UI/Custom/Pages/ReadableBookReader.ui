$C = "../Common.ui";

$C.@PageOverlay {

  $C.@DecoratedContainer {
    Anchor: (Width: 420, Height: 300);

    #Title {
      Group {
        LayoutMode: Left;

        Label #BookTitle {
          FlexWeight: 1;
          Text: "";
          Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
        }

        TextButton #CloseButton {
          Text: "X";
          Anchor: (Width: 24, Height: 24, Top: 2, Right: 8);
          Style: TextButtonStyle(
            Default: (LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Hovered: (Background: (Color: #cc4444), LabelStyle: (FontSize: 14, TextColor: #ffffff, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
            Sounds: $C.@ButtonSounds
          );
        }
      }
    }

    #Content {
      Padding: (Top: 8, Bottom: 8, Left: 16, Right: 16);
      LayoutMode: Top;

      Group {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Anchor: (Full: 0);

        Label #BookText {
          Anchor: (Left: 0, Right: 0);
          Text: "";
          Style: (FontSize: 13, TextColor: #d8cfc0, HorizontalAlignment: Start, Wrap: true);
        }
      }
    }
  }
}
