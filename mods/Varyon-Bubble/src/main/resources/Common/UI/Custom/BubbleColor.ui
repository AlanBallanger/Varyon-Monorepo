$C = "Common.ui";

@BtnStyle = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: #dcc896, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: (Color: #2a1f14)),
  Hovered: (LabelStyle: (FontSize: 14, TextColor: #ffe6a8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: (Color: #3a2a1a)),
  Pressed: (LabelStyle: (FontSize: 14, TextColor: #f3e1ca, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: (Color: #1e1508)),
  Sounds: $C.@ButtonSounds,
);

@DimBtn = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: #808890, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: (Color: #1e2d3d)),
  Hovered: (LabelStyle: (FontSize: 14, TextColor: #c0cdd8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: (Color: #253545)),
  Pressed: (LabelStyle: (FontSize: 14, TextColor: #99aabb, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center), Background: (Color: #18242f)),
  Sounds: $C.@ButtonSounds,
);

$C.@PageOverlay {
  $C.@DecoratedContainer {
    Anchor: (Width: 400, Height: 480);

    #Title {
      Group {
        Label #TitleLabel {
          Anchor: (Height: 28, Horizontal: 0);
          Style: (FontSize: 20, TextColor: #dcc896, RenderBold: true, HorizontalAlignment: Center);
          Text: "BUBBLE COLOR";
        }
      }
    }

    #Content {
      LayoutMode: Top;

      ColorPicker #ColorPicker {
        Anchor: (Width: 310, Height: 180, Top: 8);
        Format: Rgb;
        Style: $C.@DefaultColorPickerStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Width: 310, Top: 8, Height: 28);
        Padding: (Left: 4);

        Label { Text: "Hex"; Style: (FontSize: 14, RenderBold: true, TextColor: #808890, VerticalAlignment: Center); Anchor: (Width: 30); }
        Label { Anchor: (Width: 4); }
        TextField #HexField { Anchor: (Width: 100, Height: 24); Background: #2a1f14; Style: (FontSize: 14, TextColor: #dcc896); Padding: (Left: 10); }
      }

      // Bubble texture preview
      Group #PreviewBubble {
        Anchor: (Width: 96, Height: 96, Top: 8);
        Background: (TexturePath: "BubblePreview.png", Color: #f3e1caFF);
      }

      Group { Anchor: (Height: 1, Top: 8); Background: #3a3020; }

      Group {
        LayoutMode: Left;
        Padding: (Top: 12, Left: 20, Right: 20);
        Anchor: (Height: 40);

        TextButton #ApplyButton {
          Anchor: (Width: 100, Height: 34);
          Text: "Apply";
          Style: @BtnStyle;
        }
        Label { Anchor: (Width: 8); }
        TextButton #ResetButton {
          Anchor: (Width: 100, Height: 34);
          Text: "Reset";
          Style: @DimBtn;
        }
        Label { FlexWeight: 1; }
        TextButton #CloseButton {
          Anchor: (Width: 80, Height: 34);
          Text: "Close";
          Style: @DimBtn;
        }
      }
    }
  }
}
